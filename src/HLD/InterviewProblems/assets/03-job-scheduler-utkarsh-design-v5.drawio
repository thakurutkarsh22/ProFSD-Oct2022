le%3A%20normal%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20white-space%3A%20normal%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3B7.%20What%20happens%20if%20etcd%20itself%20is%20unavailable%3F%26lt%3B%2Fh2%26gt%3B%26lt%3Bp%20style%3D%26quot%3B--tw-space-y-reverse%3A%200%3B%20margin-block%3A%200px%2016px%3B%20margin%3A%206px%200px%3B%20word-break%3A%20break-word%3B%20color%3A%20rgb(204%2C%20204%2C%20204)%3B%20font-family%3A%20-apple-system%2C%20%26amp%3Bquot%3Bsystem-ui%26amp%3Bquot%3B%2C%20sans-serif%3B%20font-size%3A%2013px%3B%20font-style%3A%20normal%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20font-weight%3A%20400%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20white-space%3A%20normal%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3BThis%20is%20the%20standard%20%26quot%3Bcontrol%20plane%20vs%20data%20plane%26quot%3B%20question.%26lt%3B%2Fp%26gt%3B%26lt%3Bul%20class%3D%26quot%3Blist-inside%20list-disc%20whitespace-normal%20%5Bli_%26amp%3Bamp%3B%5D%3Apl-6%26quot%3B%20data-streamdown%3D%26quot%3Bunordered-list%26quot%3B%20style%3D%26quot%3B--tw-space-y-reverse%3A%200%3B%20margin-block%3A%200px%2016px%3B%20list-style-type%3A%20disc%3B%20white-space%3A%20normal%3B%20padding-left%3A%202em%3B%20display%3A%20flex%20!important%3B%20flex-direction%3A%20column%20!important%3B%20gap%3A%206px%20!important%3B%20margin%3A%206px%200px%20!important%3B%20color%3A%20rgb(204%2C%20204%2C%20204)%3B%20font-family%3A%20-apple-system%2C%20%26amp%3Bquot%3Bsystem-ui%26amp%3Bquot%3B%2C%20sans-serif%3B%20font-size%3A%2013px%3B%20font-style%3A%20normal%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20font-weight%3A%20400%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3B%26lt%3Bli%20class%3D%26quot%3Bpy-1%20%5B%26amp%3Bamp%3B%26amp%3Bgt%3Bp%5D%3Ainline%26quot%3B%20data-streamdown%3D%26quot%3Blist-item%26quot%3B%20style%3D%26quot%3Bpadding-block%3A%204px%3B%20word-break%3A%20break-word%3B%20padding%3A%200px%20!important%3B%26quot%3B%26gt%3B%26lt%3Bspan%20class%3D%26quot%3Bfont-semibold%26quot%3B%20data-streamdown%3D%26quot%3Bstrong%26quot%3B%20style%3D%26quot%3B--tw-font-weight%3A%20600%3B%20font-weight%3A%20600%3B%26quot%3B%26gt%3BExisting%20leases%20keep%20working%26lt%3B%2Fspan%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3Buntil%20they%20expire%20(etcd%20has%20Raft%20quorum%20loss%20requirements%3B%20if%20a%20single%20etcd%20node%20dies%2C%20the%20cluster%20keeps%20serving).%20Most%20etcd%20outages%20are%20%E2%89%A4%2030%20s%20rolling%20restarts%2C%20well%20within%20an%20existing%20lease's%20life%20if%20you%20size%20TTL%20large%20enough%20%E2%80%94%20but%20I%20deliberately%20chose%20a%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bem%26gt%3Bsmall%26lt%3B%2Fem%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3BTTL%20(3%20s)%20for%20fast%20failover%2C%20which%20trades%20resilience%20to%20etcd%20outage%20for%20dispatch%20precision.%26lt%3B%2Fli%26gt%3B%26lt%3Bli%20class%3D%26quot%3Bpy-1%20%5B%26amp%3Bamp%3B%26amp%3Bgt%3Bp%5D%3Ainline%26quot%3B%20data-streamdown%3D%26quot%3Blist-item%26quot%3B%20style%3D%26quot%3Bpadding-block%3A%204px%3B%20word-break%3A%20break-word%3B%20padding%3A%200px%20!important%3B%26quot%3B%26gt%3BIf%20etcd%20is%20fully%20unavailable%20for%20%26amp%3Bgt%3B%20TTL%3A%20leases%20expire%2C%20no%20pod%20can%20renew%20or%20grab%20new%20leases%2C%20and%20dispatch%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bspan%20class%3D%26quot%3Bfont-semibold%26quot%3B%20data-streamdown%3D%26quot%3Bstrong%26quot%3B%20style%3D%26quot%3B--tw-font-weight%3A%20600%3B%20font-weight%3A%20600%3B%26quot%3B%26gt%3Bhalts%20cleanly%26lt%3B%2Fspan%26gt%3B.%20We%20do%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bem%26gt%3Bnot%26lt%3B%2Fem%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3Bfall%20back%20to%20%26quot%3Beveryone%20scan%20everything%26quot%3B%20because%20that%20risks%20double-dispatch.%26lt%3B%2Fli%26gt%3B%26lt%3Bli%20class%3D%26quot%3Bpy-1%20%5B%26amp%3Bamp%3B%26amp%3Bgt%3Bp%5D%3Ainline%26quot%3B%20data-streamdown%3D%26quot%3Blist-item%26quot%3B%20style%3D%26quot%3Bpadding-block%3A%204px%3B%20word-break%3A%20break-word%3B%20padding%3A%200px%20!important%3B%26quot%3B%26gt%3BDuring%20halt%2C%20jobs%20continue%20to%20accumulate%20in%20Postgres.%20Once%20etcd%20recovers%2C%20leases%20get%20re-acquired%20and%20dispatch%20resumes%3B%20the%20only%20impact%20is%20that%20the%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bem%26gt%3Bfire_at%26lt%3B%2Fem%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3Bdeadline%20of%20jobs%20that%20came%20due%20during%20the%20outage%20is%20missed.%20We%20accept%20that%20%E2%80%94%20etcd%20is%20a%20documented%20control-plane%20dependency%20in%20our%20SLA.%26lt%3B%2Fli%26gt%3B%26lt%3Bli%20class%3D%26quot%3Bpy-1