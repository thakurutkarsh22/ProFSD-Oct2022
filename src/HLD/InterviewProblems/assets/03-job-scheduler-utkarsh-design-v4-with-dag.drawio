<mxfile host="app.diagrams.net" agent="cursor" version="24.0.0" type="device">
  <diagram name="HLD-v2-with-DAG-overlay" id="hld-v2-dag">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="14000" pageHeight="7000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" value="Design a Distributed Job Scheduler  (Airflow, Temporal) - NO DAG - Complex DESIGN" vertex="1"><mxGeometry height="32" width="1660" x="7880" y="1480" as="geometry"/></mxCell><mxCell id="3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=2;fontColor=#555555;" value="Author: Utkarsh — derived from 03-job-scheduler-utkarsh-design.drawio after the Q1–Q22 review.   See §21 Q&amp;A defense in 03-HighPrecisionDistributedJobScheduler.md." vertex="1"><mxGeometry height="22" width="1800" x="8070" y="1600" as="geometry"/></mxCell><mxCell id="4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;" value="1) &lt;b&gt;Functional Requirements&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Create / schedule a job (immediate / future / cron)&lt;br&gt;• Monitor status of job (real-time)&lt;br&gt;• Update / cancel a scheduled job&lt;br&gt;• Recurring (cron) jobs&lt;br&gt;&lt;br&gt;Out of scope:&lt;br&gt;• Job DAGs (Airflow-style dependencies)" vertex="1"><mxGeometry height="180" width="420" x="7730" y="1640" as="geometry"/></mxCell><mxCell id="5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;" value="2) &lt;b&gt;Non-Functional Requirements&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Throughput: 10K jobs/s avg, 40K/s peak&lt;br&gt;• Precision: p99 ≤ 2 s of fire_at&lt;br&gt;• Durability: at-least-once + idempotent target&lt;br&gt;• Availability: 99.95% submit + dispatch&lt;br&gt;• CAP: A &amp;gt; C on read &amp; dispatch; C on submit (quorum)&lt;br&gt;• Multi-tenant fairness" vertex="1"><mxGeometry height="180" width="400" x="8170" y="1640" as="geometry"/></mxCell><mxCell id="6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;" value="3) &lt;b&gt;Core Entities&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Job (id, fire_at, payload,&lt;br&gt;&amp;nbsp; cron_expr, retries, status)&lt;br&gt;• JobRun (run history)&lt;br&gt;• Outbox (txn outbox)&lt;br&gt;• Tenant (quota, allowlist)" vertex="1"><mxGeometry height="180" width="240" x="8590" y="1640" as="geometry"/></mxCell><mxCell id="7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontFamily=Courier New;" value="4) &lt;b&gt;API Designing&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. POST&amp;nbsp; /v1/jobs                       — create / schedule&lt;br&gt;2. GET&amp;nbsp;&amp;nbsp; /v1/jobs/{id}                — get details&lt;br&gt;3. GET&amp;nbsp;&amp;nbsp; /v1/jobs/{id}/status         — current status&lt;br&gt;4. PUT&amp;nbsp;&amp;nbsp; /v1/jobs/{id}                — reschedule&lt;br&gt;5. POST /v1/jobs/{id}/cancel              — best-effort cancel&lt;br&gt;6. POST /v1/jobs/{id}/runNow              — fire immediately" vertex="1"><mxGeometry height="180" width="600" x="8850" y="1640" as="geometry"/></mxCell><mxCell id="8" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;strokeWidth=2;" value="V2 fixes baked in (vs v1)&#10;━━━━━━━━━━━━━━━━━&#10;1. Redis ZSET hot tier (precision)&#10;2. Picker @ 100 ms tick (atomic pop)&#10;3. etcd shard leases (Watcher HA)&#10;4. Transactional outbox (commit/publish race)&#10;5. Cron next-occurrence emitter&#10;6. REMOVED: direct Job Svc → Kafka 2" vertex="1"><mxGeometry height="180" width="320" x="9470" y="1640" as="geometry"/></mxCell><mxCell id="9" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" value="5) High-Level Designing — V2" vertex="1"><mxGeometry height="28" width="500" x="7730" y="1850" as="geometry"/></mxCell><mxCell id="10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" value="clients / users" vertex="1"><mxGeometry height="60" width="140" x="7190" y="1985" as="geometry"/></mxCell><mxCell id="11" parent="1" style="shape=mxgraph.basic.layered_rect;dx=10;outlineConnect=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=10;spacingRight=10;strokeWidth=1;" value="LB + API Gateway&lt;br&gt;&lt;i&gt;(N pods)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• authN / authZ&lt;br&gt;• per-tenant rate limit&lt;br&gt;• routing" vertex="1"><mxGeometry height="130" width="200" x="7490" y="1950" as="geometry"/></mxCell><mxCell id="12" parent="1" style="shape=mxgraph.basic.layered_rect;dx=10;outlineConnect=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=10;spacingRight=10;strokeWidth=1;" value="&lt;b&gt;Job Svc&lt;/b&gt; &amp;nbsp;&lt;i&gt;(cluster)&lt;/i&gt;&lt;br&gt;submit / edit / cancel" vertex="1"><mxGeometry height="80" width="200" x="7963" y="1930" as="geometry"/></mxCell><mxCell id="13" parent="1" style="shape=mxgraph.basic.layered_rect;dx=10;outlineConnect=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=10;spacingRight=10;strokeWidth=1;" value="&lt;b&gt;Job Search Svc&lt;/b&gt; &amp;nbsp;&lt;i&gt;(cluster)&lt;/i&gt;&lt;br&gt;reads / status" vertex="1"><mxGeometry height="80" width="200" x="7963" y="2110" as="geometry"/></mxCell><mxCell id="14" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" value="Postgres&#10;(durable store of record)&#10;sharded by hash(job_id)&#10;partitioned by fire_minute&#10;RF = 3 (sync streaming repl)" vertex="1"><mxGeometry height="160" width="220" x="8640" y="1984" as="geometry"/></mxCell><mxCell id="15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontFamily=Courier New;" value="jobs&#10;━━━━━━━━━━━━━━&#10;• id (UUIDv7, PK)&#10;• tenant_id&#10;• fire_at_ms (idx)&#10;• fire_minute (partition)&#10;• shard (= hash(id) % 256)&#10;• schedule_type / cron_expr&#10;• status (SCHEDULED / QUEUED /&#10;&amp;nbsp; RUNNING / SUCCESS / FAILED /&#10;&amp;nbsp; CANCELED / DLQ)&#10;• payload&#10;• max_attempts, attempt_n&#10;• version (optimistic CC)&#10;• meta" vertex="1"><mxGeometry height="240" width="260" x="10610" y="1884" as="geometry"/></mxCell><mxCell id="16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontFamily=Courier New;strokeWidth=2;" value="outbox  &lt;b&gt;(NEW)&lt;/b&gt;&#10;━━━━━━━━━━━━━━&#10;• id (PK)&#10;• job_id (FK, idx)&#10;• kafka_topic&#10;• kafka_key&#10;• kafka_payload&#10;• status (pending / sent)&#10;• created_at&#10;&#10;Written in SAME txn&#10;as jobs.status='QUEUED'.&#10;Drained by outbox publisher&#10;or Debezium CDC." vertex="1"><mxGeometry height="240" width="260" x="10610" y="2144" as="geometry"/></mxCell><mxCell id="17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontFamily=Courier New;" value="job_runs (audit)&#10;━━━━━━━━━━━━━━&#10;• id (PK)&#10;• job_id (FK, idx)&#10;• status (running / success /&#10;&amp;nbsp; failed)&#10;• start_time, end_time&#10;• executor_id&#10;• attempt_number&#10;• error_msg" vertex="1"><mxGeometry height="180" width="260" x="10610" y="2404" as="geometry"/></mxCell><mxCell id="18" edge="1" parent="1" source="10" style="endArrow=classic;html=1;fontSize=11;" target="11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" edge="1" parent="1" source="11" style="endArrow=classic;html=1;fontSize=11;" target="12" value="write APIs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" edge="1" parent="1" source="11" style="endArrow=classic;html=1;fontSize=11;dashed=1;" target="13" value="read APIs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" edge="1" parent="1" source="12" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;" target="14" value="INSERT job + outbox (conditional - now case only)&lt;br&gt;in SAME txn (quorum)"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="22" edge="1" parent="1" source="13" style="endArrow=classic;html=1;fontSize=11;dashed=1;" target="14" value="read replica"><mxGeometry relative="1" x="-0.4759" y="-3" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="23" edge="1" parent="1" source="14" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" target="15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" edge="1" parent="1" source="14" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" target="16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" edge="1" parent="1" source="14" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" target="17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Kafka&#10;jobs.status&#10;(heartbeats + outcomes)" vertex="1"><mxGeometry height="100" width="180" x="9444" y="2230" as="geometry"/></mxCell><mxCell id="27" parent="1" style="shape=mxgraph.basic.layered_rect;dx=10;outlineConnect=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=10;spacingRight=10;strokeWidth=1;" value="&lt;b&gt;Status Consumer&lt;/b&gt; &amp;nbsp;&lt;i&gt;(cluster)&lt;/i&gt;&lt;br&gt;write status → Postgres&lt;br&gt;+ Redis cache" vertex="1"><mxGeometry height="90" width="200" x="9440" y="1830" as="geometry"/></mxCell><mxCell id="28" parent="1" style="shape=mxgraph.basic.layered_rect;dx=10;outlineConnect=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=10;spacingRight=10;strokeWidth=2;" value="&lt;b&gt;Cron Emitter&lt;/b&gt; &amp;nbsp;&lt;i&gt;(cluster)&lt;/i&gt; &amp;nbsp;&lt;b&gt;(NEW)&lt;/b&gt;&lt;br&gt;on success (if cron):&lt;br&gt;INSERT next row EAGERLY&lt;br&gt;before SUCCEEDED is set" vertex="1"><mxGeometry height="110" width="220" x="9740" y="1860" as="geometry"/></mxCell><mxCell id="29" edge="1" parent="1" source="26" style="endArrow=classic;html=1;fontSize=11;" target="27" value="consume"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="30" edge="1" parent="1" source="27" style="endArrow=classic;html=1;fontSize=11;dashed=1;" target="14" value="UPSERT status,&#10;append job_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="31" edge="1" parent="1" source="27" style="endArrow=classic;html=1;fontSize=11;dashed=1;" target="28" value="if cron job"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="32" edge="1" parent="1" source="28" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;" target="14" value="INSERT next_fire_at"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4c3;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;strokeWidth=2;" value="etcd  &lt;b&gt;(NEW) / zookeeper (not preferable)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;• shard → owner lease&lt;br&gt;• TTL = 3 s, hb = 1 s&lt;br&gt;• HA for Watcher + Picker" vertex="1"><mxGeometry height="124" width="250" x="7580" y="2380" as="geometry"/></mxCell><mxCell id="34" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" value="Redis&#10;last_polled_time&#10;(per shard, watcher resume)" vertex="1"><mxGeometry height="100" width="220" x="7360" y="2960" as="geometry"/></mxCell><mxCell id="35" parent="1" style="shape=mxgraph.basic.layered_rect;dx=10;outlineConnect=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=10;spacingRight=10;strokeWidth=1;" value="&lt;b&gt;Watcher / Pre-Loader&lt;/b&gt; &amp;nbsp;&lt;i&gt;(cluster)&lt;/i&gt;&lt;br&gt;per owned shard, every 1 min&lt;br&gt;5-min look-ahead scan of&lt;br&gt;jobs WHERE shard=S AND&lt;br&gt;fire_minute IN [m..m+4]" vertex="1"><mxGeometry height="130" width="220" x="7360" y="2680" as="geometry"/></mxCell><mxCell id="36" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;spacingLeft=18;spacingTop=4;verticalAlign=top;strokeWidth=2;" value="Redis ZSET  &lt;b&gt;(NEW)&lt;/b&gt;&#10;due:{shard}&#10;score = fire_at_ms&#10;member = job_id&#10;5-min hot horizon&#10;~3 M entries · ~600 MB" vertex="1"><mxGeometry height="140" width="220" x="7820" y="2675" as="geometry"/></mxCell><mxCell id="37" parent="1" style="shape=mxgraph.basic.layered_rect;dx=10;outlineConnect=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=10;spacingRight=10;strokeWidth=2;" value="&lt;b&gt;Picker&lt;/b&gt; &amp;nbsp;&lt;i&gt;(cluster)&lt;/i&gt; &amp;nbsp;&lt;b&gt;(NEW)&lt;/b&gt;&lt;br&gt;tick = 100 ms · etcd lease&lt;br&gt;Lua: ZRANGEBYSCORE + ZREM&lt;br&gt;produces to Kafka 2" vertex="1"><mxGeometry height="120" width="220" x="8240" y="2690" as="geometry"/></mxCell><mxCell id="38" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;align=left;spacingLeft=18;spacingTop=4;verticalAlign=top;" value="Kafka — dispatch&#10;━━━━━━━━━━━━&#10;topic: jobs.run&#10;topic: jobs.retry&#10;topic: jobs.dead&#10;━━━━━━━━━━━━&#10;32 partitions, RF=3&#10;key = job_id (idemp.)&#10;acks=all" vertex="1"><mxGeometry height="190" width="200" x="8700" y="2655" as="geometry"/></mxCell><mxCell id="39" parent="1" style="shape=mxgraph.basic.layered_rect;dx=10;outlineConnect=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=10;spacingRight=10;strokeWidth=1;" value="&lt;b&gt;Job Consumer Svc&lt;/b&gt; &amp;nbsp;&lt;i&gt;(cluster)&lt;/i&gt;&lt;br&gt;routes by target_type:&lt;br&gt;HTTP / Kafka / Lambda" vertex="1"><mxGeometry height="90" width="200" x="9040" y="2660" as="geometry"/></mxCell><mxCell id="40" parent="1" style="shape=mxgraph.basic.layered_rect;dx=10;outlineConnect=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=10;spacingRight=10;strokeWidth=1;verticalAlign=middle;align=center;fontSize=12;" value="&lt;b&gt;Executor Svc&lt;/b&gt; &amp;nbsp;&lt;i&gt;(cluster ≈ 100 pods)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• idempotent on job_id&lt;br&gt;• heartbeat every 10 s&lt;br&gt;• retries via jobs.retry" vertex="1"><mxGeometry height="160" width="220" x="9410" y="2625" as="geometry"/></mxCell><mxCell id="41" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=left;spacingLeft=18;spacingTop=4;verticalAlign=top;" value="Redis — cancel flags&#10;━━━━━━━━━━━━━━&#10;cancel:job:{id}&#10;TTL = until fire_at + slack&#10;&#10;Authoritative cancel:&#10;Postgres CAS on status&#10;(pre-claim by executor)" vertex="1"><mxGeometry height="160" width="240" x="9940" y="2720" as="geometry"/></mxCell><mxCell id="42" edge="1" parent="1" source="33" style="endArrow=classic;html=1;dashed=1;fontSize=11;strokeColor=#82b366;strokeWidth=2;" target="35" value="lease shards"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="43" edge="1" parent="1" source="33" style="endArrow=classic;html=1;dashed=1;fontSize=11;strokeColor=#82b366;strokeWidth=2;" target="37" value="lease"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="44" edge="1" parent="1" source="35" style="endArrow=classic;html=1;fontSize=11;startArrow=classic;startFill=1;" target="34" value="read / write&#10;last_polled_time"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="45" edge="1" parent="1" source="14" style="endArrow=classic;html=1;fontSize=11;exitX=0;exitY=1;exitDx=0;exitDy=0;" target="35" value="scan next 5 min&#10;(per owned shard)"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="46" edge="1" parent="1" source="35" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;strokeColor=#82b366;strokeWidth=2;" target="36" value="ZADD due:{shard} NX&lt;br&gt;(promote)&lt;div&gt;populate next 5 mon of jobs&amp;nbsp;&lt;/div&gt;&lt;div&gt;here&lt;/div&gt;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="47" edge="1" parent="1" source="12" style="endArrow=classic;html=1;fontSize=11;dashed=1;strokeColor=#82b366;strokeWidth=2;" target="36" value="if fire_at ≤ 5 min:&#10;ZADD (best-effort)"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="48" edge="1" parent="1" source="36" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;strokeColor=#82b366;strokeWidth=2;" target="37" value="pop due (100 ms tick)&#10;ZRANGEBYSCORE+ZREM"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="49" edge="1" parent="1" source="37" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;strokeColor=#82b366;strokeWidth=2;" target="38" value="produce&#10;(key=job_id)"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="50" edge="1" parent="1" source="38" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;" target="39" value="consume"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="51" edge="1" parent="1" source="39" style="endArrow=classic;html=1;fontSize=11;" target="40" value="dispatch"><mxGeometry relative="1" x="-0.0588" y="15" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="52" edge="1" parent="1" source="39" style="endArrow=classic;html=1;fontSize=11;" target="40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="53" edge="1" parent="1" source="39" style="endArrow=classic;html=1;fontSize=11;" target="40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="54" edge="1" parent="1" source="12" style="endArrow=classic;html=1;fontSize=11;dashed=1;" target="41" value="POST /cancel → set flag&#10;(also Postgres CAS to CANCELED)"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="55" edge="1" parent="1" source="40" style="endArrow=classic;html=1;fontSize=11;dashed=1;" target="41" value="check before run&#10;(then Postgres CAS&#10;QUEUED → RUNNING)"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="56" edge="1" parent="1" source="40" style="endArrow=classic;html=1;fontSize=11;dashed=1;exitX=0;exitY=0;exitDx=0;exitDy=0;" target="26" value="status / heartbeat&#10;every 10 s + on completion"><mxGeometry relative="1" x="0.3803" y="5" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="57" parent="1" style="shape=mxgraph.basic.layered_rect;dx=10;outlineConnect=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingTop=6;spacingLeft=10;spacingRight=10;strokeWidth=2;" value="&lt;b&gt;Outbox Publisher&lt;/b&gt; &amp;nbsp;&lt;i&gt;(cluster)&lt;/i&gt; &amp;nbsp;&lt;b&gt;(NEW)&lt;/b&gt;&lt;br&gt;Debezium CDC tail of&lt;br&gt;jobs &amp;amp; outbox tables&lt;br&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;→ &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;at least once between&lt;/span&gt;&lt;/div&gt;Postgres &amp;amp; Kafka 2" vertex="1"><mxGeometry height="120" width="220" x="8690" y="2990" as="geometry"/></mxCell><mxCell id="58" edge="1" parent="1" source="16" style="endArrow=classic;html=1;fontSize=11;dashed=1;strokeColor=#82b366;strokeWidth=2;" target="57" value="poll / CDC"><mxGeometry relative="1" x="-0.3872" y="2" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="59" edge="1" parent="1" source="57" style="endArrow=classic;html=1;fontSize=11;dashed=1;strokeColor=#82b366;strokeWidth=2;" target="38" value="republish (failsafe)"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="60" edge="1" parent="1" source="40" style="endArrow=classic;html=1;fontSize=11;dashed=1;entryX=1;entryY=1;entryDx=0;entryDy=-15;entryPerimeter=0;" target="38" value="failure → jobs.retry&#10;(exp backoff)"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="61" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;" value="Stuck-IN_FLIGHT Sweeper&#10;━━━━━━━━━━━━━━&#10;every N min:&#10;status=RUNNING AND&#10;lease_until &amp;lt; now&#10;→ reset to SCHEDULED&#10;&amp;nbsp;&amp;nbsp; (attempts++)&#10;&#10;Lease, not 15s timer." vertex="1"><mxGeometry height="160" width="280" x="7650" y="3490" as="geometry"/></mxCell><mxCell id="62" edge="1" parent="1" source="61" style="endArrow=classic;html=1;fontSize=11;dashed=1;" target="14" value="reconcile"><mxGeometry relative="1" x="-0.3126" y="-5" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="63" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;" value="Latency budget (p99 ≤ 2 s):&#10;━━━━━━━━━━━━━━━━━&#10;• Picker tick:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 100 ms&#10;• Redis Lua pop:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 10 ms&#10;• Kafka produce ack:&amp;nbsp;&amp;nbsp;&amp;nbsp; 20 ms&#10;• Consumer poll:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 100 ms&#10;• Worker → target:&amp;nbsp;&amp;nbsp;&amp;nbsp; 200 ms&#10;━━━━━━━━━━━━━━━━━&#10;p99 ≈ 500 ms · headroom 1.5 s&#10;for GC + tail." vertex="1"><mxGeometry height="180" width="320" x="8040" y="3460" as="geometry"/></mxCell><mxCell id="64" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;" value="Key invariants&#10;━━━━━━━━━━━━━━━━━━━━━━&#10;1. ONLY the Picker produces to Kafka 2 (Q2). No direct push from Job Svc.&#10;2. Lua ZRANGEBYSCORE+ZREM = at-most-one dispatcher per job (Q15).&#10;3. Outbox + CAS on jobs.status = no &quot;stuck QUEUED&quot; rows (Q6).&#10;4. Cron next-occurrence is INSERTED before SUCCEEDED (Q10).&#10;5. Cancel = Redis fast-path + Postgres CAS source-of-truth (Q8).&#10;6. Lease + heartbeat for stuck jobs, NOT a 15s wall clock (Q7).&#10;7. Submit jitters fire_at by U(0,30s) unless tenant opts out (Q16)." vertex="1"><mxGeometry height="180" width="700" x="8390" y="3460" as="geometry"/></mxCell><mxCell id="65" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;" value="Legend&#10;━━━━━━━━━━━━━━━━━━━━━━&#10;Solid arrow  = data path on hot path&#10;Dashed arrow = control / async / best-effort&#10;Cylinder      = durable store / topic / cache&#10;Sticky note  = invariants &amp; trade-offs&#10;&#10;Colors:&#10;• blue   = stateless service&#10;• green  = durable store / V2 fix&#10;• pink   = cache (Redis)&#10;• purple = queue/stream (Kafka)&#10;• yellow = note / schema / control plane" vertex="1"><mxGeometry height="220" width="320" x="9120" y="3460" as="geometry"/></mxCell><mxCell id="66" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;" value="Alternatives at the hot tier&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;• Redis ZSET (chosen) — score = fire_at_ms; Lua atomic pop. Sub-second precision; bounded by Redis memory (~600 MB / 5-min window).&#10;• Hierarchical Timer Wheel (in-process, per dispatcher) — sub-10 ms precision; volatile; needs cold rebuild from DB on pod restart.&#10;• Cassandra hot index — partition by (shard, fire_minute); scales beyond Redis horizon but at the cost of 1-min scan cadence.&#10;• Amazon SQS DelaySeconds (≤ 15 min) — last-mile only; no cancel, no precision guarantee.&#10;• Don't use plain Kafka as a scheduler — no native delay primitive; topic-per-bucket is an anti-pattern.&#10;Durable store: Cassandra preferred at 75B-row scale; sharded Postgres acceptable up to ~1 TB / shard." vertex="1"><mxGeometry height="160" width="2360" x="7700" y="3800" as="geometry"/></mxCell><UserObject label="&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;1. The problem etcd is solving&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Without etcd you're forced into one of two bad designs:&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Bad option A — single Watcher / single Picker pod.&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 26px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 26px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 36px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;Job Svc → Postgres → [single Watcher pod] → Redis ZSET → [single Picker pod] → Kafka&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;That's a Single Point of Failure on the dispatch hot path. If that pod crashes, GCs for 5 s, or gets evicted,&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;every fire_at deadline within that window is missed&lt;/span&gt;. With a p99 ≤ 2 s SLO, even a single pod restart blows your SLO.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Bad option B — every Watcher pod scans every shard, every Picker pod pops every ZSET.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;That's HA, but now you have 256 shards × N pods doing the same work:&lt;/p&gt;&lt;ul class=&quot;list-inside list-disc whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;unordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: disc; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Each pre-load scan runs N times against Postgres (= N× DB load).&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Each ZADD into&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;due:{shard}&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;is racing across N pods. The&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;NX&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;flag makes it safe, but you do N round-trips per row.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Each 100 ms tick fires N times per shard against Redis. The Lua&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;ZRANGEBYSCORE+ZREM&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;is atomic, so only one pod actually wins each job — but the other N−1 pods still spend a Redis round-trip per tick per shard. At 100 ms × 256 shards × N pods that's&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;~2,560·N Redis ops/sec just on idle dispatch ticks&lt;/span&gt;.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Worse, on the same job, multiple Pickers can each see it as &quot;due&quot;, race the Lua, and the loser ones just got slower for no reason. And every loser counts against the 100 ms tick budget.&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;So I want&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;exactly one Watcher pod and exactly one Picker pod per shard at any moment&lt;/span&gt;, but I also want&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;automatic failover within seconds&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;when that pod dies. That's distributed leader election per shard, and etcd is the textbook tool for it.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;2. Why etcd specifically (vs alternatives)&lt;/h2&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; --scrollbar-size: 6px; --scrollbar-inset: 0px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr; margin: 1em 0px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; border-radius: 6px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: auto; min-width: 100%; max-width: 100%; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;table style=&quot;color: inherit; font-size: inherit; border-collapse: collapse; width: max-content; min-width: 100%; --markdown-table-prose-cell-inline-size: 40ch;&quot;&gt;&lt;thead class=&quot;bg-muted/80&quot; data-streamdown=&quot;table-header&quot; style=&quot;background: none !important;&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;Option&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;Verdict&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody class=&quot;divide-y divide-border bg-muted/40&quot; data-streamdown=&quot;table-body&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;etcd&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;(chosen)&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Strongly consistent (Raft), native&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;Lease&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;primitive with TTL, atomic CAS on key creation,&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;Watch&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;API. Same primitive Kubernetes uses for&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;kube-controller-manager&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;leader election.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;ZooKeeper&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Equally fine, ephemeral nodes ≈ leases. Older API, heavier ops.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Redis + Redlock&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Co-located with our hot tier but&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;weaker safety guarantees&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;under GC pauses / clock skew (Kleppmann's critique). Not acceptable when an incorrect lease causes double dispatch.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Consul&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Similar to etcd, fine.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Postgres advisory lock&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Possible, but couples coordination to your durable store and adds DB load on a hot path.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;hash(shard) % numPods&lt;/code&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;No coordination. Catastrophic on rolling deploys — every shard moves on every restart. Also no fencing if a pod is &quot;dead&quot; but the controller hasn't noticed.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;3. The lease mechanic in one paragraph&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;A pod creates an etcd&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;Lease&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;with&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;TTL = 3 s&lt;/code&gt;. Then it does an atomic put:&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;&quot;create the key&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-path-filename-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;&lt;span class=&quot;md-inline-path-prefix&quot;&gt;/scheduler/shard/42/&lt;/span&gt;&lt;span class=&quot;md-inline-path-filename&quot;&gt;owner = pod-A&lt;/span&gt;&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;only if it doesn't already exist, and attach it to my lease.&quot;&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;If the put succeeds, pod A owns shard 42. Pod A then sends a&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;KeepAlive&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;heartbeat every&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;1 s&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;(TTL/3, the standard pattern). If pod A dies, GC's, partitions, or just stops heartbeating, etcd revokes the lease ≤ 3 s later and&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;automatically deletes the key&lt;/span&gt;. Any other pod that's&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;Watch&lt;/code&gt;ing that prefix sees the deletion and races to grab the now-vacant key. Whoever wins is the new owner. Maximum dispatch outage per shard: ~3 s (TTL) + ~100 ms (re-grab) ≈&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;3.1 s tail&lt;/span&gt;, which is why I picked 3 s and not 10 s.&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 166px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 166px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 176px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;t=0      pod-A grabs lease(3s) on shard 42, starts polling/picking&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;t=0..N   pod-A heartbeats every 1 s&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;t=Tx     pod-A's kernel panics&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;t=Tx+1s  no heartbeat 1&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;t=Tx+2s  no heartbeat 2&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;t=Tx+3s  etcd revokes lease, deletes /scheduler/shard/42/owner&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;t=Tx+3s  pod-B's Watch fires, CAS-creates the key with its own lease&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;t=Tx+3.1 pod-B is now the active picker for shard 42&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;4. What the Watcher does with its lease&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The Watcher's job is to keep the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Redis ZSET hot tier&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;populated with the next 5 minutes' worth of due jobs from Postgres.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Per&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;owned&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;shard&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;S&lt;/code&gt;, every minute:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 106px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 106px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 116px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;SELECT id, fire_at_ms&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;FROM   jobs&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;WHERE  shard &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; :S&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  AND  fire_minute IN (:m, :m&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;+&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, :m&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;+&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;2&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, :m&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;+&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;3&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, :m&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;+&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;4&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  AND  &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;SCHEDULED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Then for each row:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 26px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 26px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 36px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;ZADD due:{S} NX &amp;lt;fire_at_ms&amp;gt; &amp;lt;job_id&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Why the lease matters here:&lt;/p&gt;&lt;ul class=&quot;list-inside list-disc whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;unordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: disc; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Without the lease&lt;/span&gt;: 256 shards × N pods × 1 query/min = 256·N queries/min hammering Postgres for the same data. Each query also returns the same 10k-ish rows, all of which trigger redundant ZADDs.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;With the lease&lt;/span&gt;: exactly 256 queries/min, period. Postgres sees ~4 queries/sec instead of ~4·N qps. Redis ZADDs are at the natural rate of new schedules.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;It also makes&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;last_polled_time:{shard}&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;(cell 34, the resume cursor) safe — only one writer per shard, so no read-modify-write races.&lt;/li&gt;&lt;/ul&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;5. What the Picker does with its lease&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The Picker's job is to drain the ZSET as soon as score (= fire_at_ms) crosses&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;now()&lt;/code&gt;, and produce to Kafka 2.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Per&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;owned&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;shard&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &am