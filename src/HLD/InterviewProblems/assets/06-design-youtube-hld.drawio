        <!-- ============== ROW 6: STORES ============== -->

        <mxCell id="origin_raw" value="Origin Object Store — RAW&#10;(GCS / S3)&#10;&#10;original master file&#10;sha256 keyed&#10;180-day retention&#10;then deletion-eligible&#10;encrypted at rest (KMS)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
