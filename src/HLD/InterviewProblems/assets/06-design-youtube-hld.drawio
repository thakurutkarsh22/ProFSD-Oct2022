          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============== STICKY NOTES — INVARIANTS ============== -->

        <mxCell id="note_ttff" value="Time-To-First-Frame (TTFF) budget — p99 ≤ 1 s:&#10;• DNS + TLS handshake to PoP: 100 ms (close to user)&#10;• /watch API → manifest URL: 80 ms (cached metadata)&#10;• fetch .m3u8 manifest: 50 ms (CDN-cached)&#10;• fetch first .ts segment (4 s @ 720p ≈ 1 MB): 300 ms&#10;• demux + decode warm-up: 200 ms&#10;TOTAL ≈ 730 ms p50 · ~1 s p99 (with cache hit)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="2840" y="1080" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e_note_ttff" style="endArrow=none;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="note_ttff" target="watch_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note_xc" value="Transcoding throughput:&#10;• 500 hrs uploaded/min &gt; 30 K hrs/hr&#10;• must encode &gt; 1× real-time per worker&#10;• split video into N GOP chunks → encode in parallel&#10;• 1 hr 1080p ≈ 5 min on 8 GPUs (~12× real-time)&#10;• ladder = 7 renditions · ~30 K hrs/hr × 7 ≈ 210 K&#10;  rendition-hrs/hr → ~30 K active GPUs steady-state" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="2840" y="1260" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e_note_xc" style="endArrow=none;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="note_xc" target="xc_workers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note_egress" value="CDN egress numbers:&#10;• 1 B watch-hours/day · ~3 Mbps avg = ~3 EB/day egress&#10;• 95% from edge / ISP-cache → only ~5% bytes touch origin&#10;• shield tier reduces origin RPS 10×&#10;• range-requests friendly: each .ts cached independently&#10;• manifests TTL 30 s (allow rolling-window updates for live)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="2840" y="1440" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e_note_egress" style="endArrow=none;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="note_egress" target="cdn_pop2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note_consistency" value="Consistency contract:&#10;• Video metadata: STRONG (Spanner) — title/desc/owner cannot stale&#10;• Comments / likes: EVENTUAL (Bigtable) — OK to be ~seconds stale&#10;• View count: EVENTUAL · ≤ 60 s freshness&#10;• Recommendations: STALE-OK — TTL 5 min reco cache&#10;• DRM license: STRONG · must check entitlement at request time" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="2840" y="1620" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e_note_consistency" style="endArrow=none;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="note_consistency" target="meta_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============== FLOW LEGEND ============== -->

        <mxCell id="legend_box" value="Flow Legend  (8 numbered flows)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=14;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="1820" width="2080" height="280" as="geometry" />
        </mxCell>

        <mxCell id="legend_U_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1865" as="sourcePoint" />
            <mxPoint x="180" y="1865" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_U_text" value="U — Upload (5 steps): Creator → API GW → Upload Svc → Origin RAW + Metadata DB → produce video.uploaded" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="200" y="1850" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_T_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1900" as="sourcePoint" />
            <mxPoint x="180" y="1900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_T_text" value="T — Transcoding (7 steps): Kafka video.uploaded → Workers split &amp; encode (HLS/DASH ladder) → write Origin TRANSCODED → spawn Thumb / ASR / ContentID / Safety → publish video.transcoded → mark PUBLISHED" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="200" y="1885" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_W_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#C62828;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1935" as="sourcePoint" />
            <mxPoint x="180" y="1935" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_W_text" value="W — Watch (7 steps): Client → CDN PoP (cache-hit) → on miss → Shield → Origin TRANSCODED.   /watch API → Watch Svc → Metadata DB / Redis → manifest URL + DRM license URL." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="200" y="1920" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_R_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#6A1B9A;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1970" as="sourcePoint" />
            <mxPoint x="180" y="1970" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_R_text" value="R — Recommendation (6 steps): /home → Reco Svc → reco-cache (Redis) → if miss → candidate-gen → ranker (DNN, TF-Serving) → personalised list (TTL 5 m). Pipeline trains nightly + streaming features." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="200" y="1955" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_E_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#00838F;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="2005" as="sourcePoint" />
            <mxPoint x="180" y="2005" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_E_text" value="E — Engagement (4 steps): /comment | /like → Engagement Svc → INSERT Comments DB + outbox → Outbox Publisher → produce engagement.events → derive notify.events." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#00838F;" vertex="1" parent="1">
          <mxGeometry x="200" y="1990" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_V_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#EF6C00;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="2040" as="sourcePoint" />
            <mxPoint x="180" y="2040" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_V_text" value="V — View Count (6 steps): client beacon (>30 s view) → View Svc → watch.events → Flink View Aggregator (1-min tumbling) → INCR Bigtable + Redis HLL → emit features.stream → feed Trending." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#EF6C00;" vertex="1" parent="1">
          <mxGeometry x="200" y="2025" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_L_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#4E342E;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="2075" as="sourcePoint" />
            <mxPoint x="180" y="2075" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_L_text" value="L — Live Streaming (4 steps): Encoder RTMP/SRT push → Live Ingest (anycast) → Live Transcoder (LL-HLS, 1-s chunks) → Origin TRANSCODED + live.segments → CDN edge serves chunked transfer." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#4E342E;" vertex="1" parent="1">
          <mxGeometry x="200" y="2060" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_S_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#455A64;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="2065" as="sourcePoint" />
            <mxPoint x="180" y="2065" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Style legend (right side) -->
        <mxCell id="style_legend" value="Style Legend&#10;━━━━━━━━━━━━&#10;• Solid arrow  = data path on hot path&#10;• Dashed arrow = control / async / best-effort&#10;• Cylinder      = durable store / Kafka topic / index&#10;• Stacked rect = N-pod stateless service&#10;• Sticky note  = invariants &amp; trade-offs&#10;• Black box    = external system (CDN ISP, Bank, DMCA)&#10;━━━━━━━━━━━━&#10;Color palette (from assets/README.md):&#10;• Blue   — stateless services / dispatchers&#10;• Green  — durable stores / DBs&#10;• Red    — caches / hot tiers / CDN&#10;• Purple — Kafka topics / streaming&#10;• Yellow — coordination / control plane&#10;• Orange — sweepers / safety nets" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="2200" y="1820" width="320" height="280" as="geometry" />
        </mxCell>

        <mxCell id="capacity_note" value="Back-of-envelope (peak):&#10;• 800 M DAU × 30 min/day × ~3 Mbps avg = ~4 EB egress/day&#10;• Concurrent watchers: ~200 M peak&#10;• Uploads: 500 hrs/min = ~30 K hrs/hr · ~10 PB/day raw&#10;• Watch beacons: 800 M × ~5/session = 4 B events/day → ~50 K events/s peak&#10;• Comments: ~100 M/day → ~3 K/s peak&#10;• Recommendation QPS: 800 M × ~5 home loads/day = ~50 K QPS peak&#10;• Search QPS: ~30 K peak&#10;━━━━━━━━━━━━&#10;Storage:&#10;• Hot transcoded: ~PBs · evicted to cold &gt;180 d if &lt; 1 view/day&#10;• Metadata: ~10 B videos × ~2 KB ≈ 20 TB (Spanner)&#10;• Comments: ~10 B comments × ~500 B ≈ 5 TB (Bigtable, sharded)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="2540" y="1820" width="320" height="280" as="geometry" />
        </mxCell>

        <!-- ============== AUTHOR / SOURCE FOOTER ============== -->
