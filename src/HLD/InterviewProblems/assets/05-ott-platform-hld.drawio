        <mxCell id="e_p_play_redis" value="P4: Lua CAS streams:{u}" style="endArrow=classic;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#C62828;" edge="1" parent="1" source="play_svc" target="redis_hot">
