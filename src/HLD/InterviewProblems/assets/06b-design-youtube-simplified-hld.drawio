  <diagram name="YouTube-Simplified-HLD" id="hld-yt-simple-1">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============== TITLE ============== -->
        <mxCell id="title" value="Design YouTube — SIMPLIFIED High-Level Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="10" width="1400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="800 M DAU · 200 M peak concurrent watchers · 500 hrs uploaded/min · ~250 Tbps egress · ≥ 95% CDN cache-hit · TTFF p99 ≤ 1 s · view-count freshness ≤ 60 s" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="300" y="44" width="2000" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Companion to 06b-DesignYouTube-Simplified.md   |   Cut from full diagram: DRM, ContentID, Search re-ranker, Live transcoder split, Moderation console, Ad exchanges, Cold-archive, Payment partners, Audit log, OLAP, ASR" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="200" y="68" width="2200" height="20" as="geometry" />
        </mxCell>

        <!-- ============== ROW 1: CLIENTS ============== -->

        <mxCell id="row1_label" value="CLIENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="80" height="20" as="geometry" />
        </mxCell>

        <mxCell id="client_mobile" value="Mobile App&#10;(iOS / Android)&#10;&#10;HLS player · ABR&#10;30-s view beacon" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="110" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="client_web" value="Web SPA&#10;(YouTube.com)&#10;&#10;DASH / HLS player&#10;hls.js · Shaka" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="client_tv" value="Smart TV / Console&#10;(Roku · PS5 · Tizen)&#10;&#10;DASH (4K)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="110" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="client_creator" value="Creator Studio&#10;(uploader)&#10;&#10;resumable chunks&#10;8 MB → 256 KB on slow nets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="110" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="client_live" value="Live Encoder&#10;(OBS · ffmpeg)&#10;&#10;RTMP / SRT push" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Traffic split annotation -->
        <mxCell id="traffic_split" value="Two planes:&#10;• ~5 % bytes via REST APIs (control plane)&#10;• ~95 % bytes via CDN segments (data plane)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1220" y="110" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- ============== ROW 2: EDGE (CDN + ORIGIN SHIELD + API GATEWAY) ============== -->

        <mxCell id="row2_label" value="EDGE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="80" height="20" as="geometry" />
        </mxCell>

        <!-- Multi-CDN -->
        <mxCell id="cdn" value="Multi-CDN&#10;(Akamai · CloudFront · Cloudflare)&#10;+ ~15 K ISP-resident appliances&#10;&#10;hit ratio ≥ 95 %&#10;serves manifests + .ts/.m4s segments&#10;weights refreshed every 30 s from cdn.qoe" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="270" width="320" height="170" as="geometry" />
        </mxCell>

        <!-- Origin Shield -->
        <mxCell id="origin_shield" value="Origin Shield&#10;(regional NGINX / Varnish)&#10;&#10;coalesces CDN misses&#10;cuts origin egress ~200×&#10;1 region per: us-east, eu-west, ap-south" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="270" width="280" height="170" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="api_gw_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="880" y="290" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="api_gw_back1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="870" y="280" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="api_gw" value="API Gateway / Edge LB&#10;(Envoy · multi-region)&#10;&#10;TLS 1.3 + 0-RTT&#10;JWT validate · GeoIP (MaxMind)&#10;rate-limit (token bucket / Redis)&#10;Idempotency-Key (24 h)&#10;routes: /watch /upload /home /comment /beacon" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="270" width="320" height="150" as="geometry" />
        </mxCell>

        <!-- RTMP / SRT Ingest (live) -->
        <mxCell id="rtmp_ingest" value="RTMP / SRT Ingest&#10;(regional anycast)&#10;&#10;active/standby per stream&#10;etcd lease 3 s TTL&#10;forwards to Live Transcoder" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="270" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- TTFF budget callout -->
        <mxCell id="ttff_note" value="Watch TTFF budget (p99 ≤ 1 s):&#10;• TLS to PoP            100 ms&#10;• API GW + auth          15 ms&#10;• Watch Svc metadata     30 ms&#10;• Manifest sign + route  25 ms&#10;• Mobile RTT             80 ms&#10;• Player parse / init   100 ms&#10;• First segment fetch   400 ms&#10;• Decoder warm-up       200 ms&#10;CDN cache miss adds ~150 ms shield RTT" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1520" y="270" width="280" height="170" as="geometry" />
        </mxCell>

        <!-- ============== ROW 3: SERVICES (THE ESSENTIAL FOUR + LIVE TRANSCODER) ============== -->

        <mxCell id="row3_label" value="SERVICES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="80" height="20" as="geometry" />
        </mxCell>

        <mxCell id="watch_svc" value="Watch / Manifest Svc&#10;(stateless · gatekeeper)&#10;&#10;GET /watch?v={id}&#10;privacy + geo + age check&#10;sign manifest URL (HMAC, 6 h TTL)&#10;pick CDN PoP (ASN-based)&#10;p99 ≤ 80 ms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="upload_svc" value="Upload Svc&#10;(stateless)&#10;&#10;POST /upload/init → signed GCS URL&#10;client PUTs chunks DIRECT to GCS&#10;(8 MB · resumable · TUS-like)&#10;dedup by (user_id, sha256)&#10;produces video.uploaded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="reco_svc" value="Recommendation Svc&#10;(stateless · two-stage)&#10;&#10;GET /home → Redis row&#10;Stage 1: candidate-gen (ANN + collab)&#10;Stage 2: ranker DNN (TF-Serving, ~5 ms)&#10;reads features from feature store&#10;p99 ≤ 100 ms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="engagement_svc" value="Engagement Svc&#10;(comments · likes · subs)&#10;&#10;POST /comment, /like, /subscribe&#10;toxicity classifier (~10 ms) before persist&#10;outbox row in same txn&#10;rate-limit per account + per channel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1110" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="beacon_svc" value="View Beacon Collector&#10;(stateless · &gt; 500 K req/s peak)&#10;&#10;POST /beacon&#10;reject if cumulative_play_ms &lt; 30 s&#10;dedup: SADD seen_views:{day}:{user_id}&#10;produce watch.events.VIEW (Kafka)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1420" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="live_transcoder" value="Live Transcoder + Packager&#10;(GPU NVENC · CMAF chunked)&#10;&#10;200-ms partials → LL-HLS&#10;writes 1-s segments to GCS&#10;produces live.segments&#10;~3.5 s glass-to-glass" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1730" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- ============== ROW 4: KAFKA BACKBONE (one bar with topic chips) ============== -->

        <mxCell id="row4_label" value="ASYNC&#10;BACKBONE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="80" height="40" as="geometry" />
        </mxCell>

        <mxCell id="kafka_bar" value="Kafka backbone — RF=3, idempotent producer, transactional consumer, outbox pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5e6f5;strokeColor=#9673a6;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="700" width="1830" height="100" as="geometry" />
        </mxCell>

        <mxCell id="kf_uploaded" value="video.uploaded&#10;(48 part)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="195" y="735" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kf_transcoded" value="video.transcoded&#10;(48 part)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="375" y="735" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kf_watch" value="watch.events&#10;(256 part, key=user_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="735" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kf_engagement" value="engagement.events&#10;(128 part)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="765" y="735" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kf_features" value="features.stream&#10;(256 part)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="975" y="735" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kf_notify" value="notify.events&#10;(64 part, key=recipient_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1165" y="735" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kf_live" value="live.segments&#10;(per-stream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1395" y="735" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kf_audit" value="audit.events&#10;(append-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1575" y="735" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kf_dlq" value="*.dlq&#10;(retry / quarantine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1755" y="735" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- ============== ROW 5: STORAGE ============== -->

        <mxCell id="row5_label" value="STORAGE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="80" height="20" as="geometry" />
        </mxCell>

        <mxCell id="gcs_raw" value="GCS / S3 — RAW + Transcoded&#10;&#10;raw masters (180-d retention)&#10;CMAF segments (.cmfv) →&#10;wrapped as HLS .m3u8 + DASH .mpd&#10;~5 EB total · 11-nines durable&#10;cross-region replication" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="850" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="spanner" value="Spanner — Metadata&#10;(strong consistency)&#10;&#10;videos · channels · users · subscriptions&#10;sharded by video_id (ULID)&#10;privacy / geo flips visible immediately&#10;~20 TB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="850" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="bigtable" value="Bigtable — Events + Counters&#10;(eventual consistency)&#10;&#10;comments (PK = video_id + reverse_ts)&#10;watch_events (append-only beacons)&#10;view_counters (16 shards/row)&#10;wide-row pagination" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="850" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="Redis Hot Cache&#10;&#10;video metadata (TTL 5 m)&#10;reco rows: home:{user_id}&#10;view counts (HINCRBY · TTL 30 s)&#10;HLL: viewers:{video_id}:{day}&#10;dedup Sets: seen_views:{day}:{user_id}&#10;rate-limit token buckets" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1110" y="850" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="search_index" value="Elasticsearch + Vespa&#10;&#10;BM25 (keyword) + ANN (vectors)&#10;rebuild nightly + delta&#10;~20 TB enriched" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1420" y="850" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="feature_store" value="Feature Store&#10;(BigQuery + Bigtable)&#10;&#10;user vectors · video vectors&#10;updated &lt; 60 s from event&#10;feeds offline ranker training" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1730" y="850" width="280" height="180" as="geometry" />
        </mxCell>

        <!-- ============== ROW 6: ASYNC PROCESSORS ============== -->

        <mxCell id="row6_label" value="PROCESSORS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="90" height="20" as="geometry" />
        </mxCell>

        <mxCell id="transcode_pool" value="Transcoding Pool&#10;(GPU farm · NVENC)&#10;&#10;split video into ~10-s GOPs&#10;encode in parallel across N workers&#10;7 ABR rungs (144p → 1440p)&#10;CMAF source · 12× real-time&#10;workflow: Argo / Temporal&#10;lazy ladder for long tail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="1080" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="flink_view" value="Flink — View Counter Rollup&#10;&#10;tumbling 1-min windows on watch.events&#10;keyBy(video_id, day)&#10;sinks:&#10;  • Bigtable INCR (sharded counter)&#10;  • Redis HINCRBY (hot read)&#10;  • Redis PFADD (HLL unique-viewers)&#10;  • features.stream (CTR delta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="530" y="1080" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="flink_features" value="Flink — Feature Streaming&#10;&#10;consumes watch.events + engagement.events&#10;updates per-user features in feature store&#10;within seconds&#10;&#10;Spark nightly retrains ranker DNN→ Model Store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="1080" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="notify_worker" value="Notification Fan-out&#10;(Mr Beast scale)&#10;&#10;consumes notify.events (key=recipient)&#10;APNS / FCM / SES batch APIs&#10;1 K tokens per call · per-user 24-h dedup&#10;daily digest above threshold&#10;250 M subs → ~5 min wall-clock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1080" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="cdn_prewarmer" value="CDN Pre-warmer&#10;&#10;on video.transcoded:&#10;  if predicted_views_24h &gt; 100 K&#10;  push first 30 s of segments&#10;  to all PoPs in creator's region&#10;avoids cold-cache stampede" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1080" width="320" height="180" as="geometry" />
        </mxCell>

        <!-- ============== KEY INVARIANTS PANEL (right side) ============== -->

        <mxCell id="invariants" value="THE 6 INVARIANTS (whiteboard cheat-sheet)&#10;&#10;1. CDN serves the BYTES; origin serves the METADATA.&#10;    ~95 % of egress comes from edge / ISP-cache.&#10;&#10;2. CMAF source · two manifests.&#10;    One encode → both HLS .m3u8 and DASH .mpd.&#10;    Halves storage from ~10 EB → ~5 EB.&#10;&#10;3. View counts are eventually consistent ≤ 60 s.&#10;    Redis HLL + Flink rollup + sharded Bigtable counter.&#10;    NEVER block watch-page render on a strong count read.&#10;&#10;4. Comments are eventual; metadata is strong.&#10;    A creator flipping privacy → effective immediately.&#10;&#10;5. Multi-CDN, weighted by real-time QoE.&#10;    A single CDN PoP outage during a marquee event&#10;    must not take down &gt; 30 % of viewers.&#10;&#10;6. Already-playing streams keep playing during outages.&#10;    Manifest TTL 6 h + segment cache shield Watch Svc&#10;    failures from in-progress viewers." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2050" y="490" width="500" height="500" as="geometry" />
        </mxCell>

        <mxCell id="failures_note" value="TOP REAL-WORLD FAILURES (see §11 of the .md)&#10;&#10;• Hot-row counter contention → Redis HLL + Flink + sharded INCR&#10;• Cold-cache stampede on viral upload → CDN pre-warm + shield coalesce&#10;• Single CDN PoP outage → multi-CDN weighting (etcd, 30 s)&#10;• Mr Beast 250 M-sub fan-out → batched APNS/FCM, partition by recipient&#10;• Transcoding backlog → 3 priority queues + spot-instance overflow&#10;• Redis cold-start cache stampede → tiered fallback + recompute throttle&#10;• Bot views → play-session token, IP entropy, behavioural fingerprint&#10;• Live ingest failover → etcd 3 s lease + pre-warmed standby in shadow mode&#10;• Mobile chunk failures → adaptive 256 KB chunks + background upload&#10;• Storage cost explosion → lazy ladder + cold-tier after 30 d no views" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2050" y="1010" width="500" height="250" as="geometry" />
        </mxCell>

