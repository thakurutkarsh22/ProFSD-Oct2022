          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mod_cat" value="hide / withdraw" style="endArrow=classic;html=1;rounded=0;strokeColor=#D79B00;strokeWidth=1.5;fontSize=11;fontColor=#D79B00;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="moderation" target="cat_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Mezz → Cold archive -->
        <mxCell id="e_mez_cold" value="lifecycle: 30 d → Glacier" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontColor=#666666;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="s3_mez" target="cold_archive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DWH ETL -->
        <mxCell id="e_kfviewing_dwh" value="ETL · daily" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontColor=#666666;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="kf_viewing" target="dwh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ad servers (SSAI) -->
        <mxCell id="e_pkg_ads" value="manifest stitching (SSAI)" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontColor=#666666;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="pkg_svc" target="ad_servers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Editorial / Studio -->
        <mxCell id="e_creator_studio" value="reports · royalty stmts" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontColor=#666666;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dwh" target="creators_studio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============== STICKY NOTES — INVARIANTS ============== -->

        <mxCell id="note_ttff" value="Time-To-First-Frame (TTFF) budget — p95 ≤ 2 s:&#10;• Tap → API GW (mobile RTT, TLS): 200 ms&#10;• API GW (JWT, geo, rate-limit): 20 ms&#10;• Playback Svc (sub + concurrent + license + sign): 30 ms&#10;• Player parses manifest + picks bitrate: 300 ms&#10;• DRM license challenge → license: 400 ms&#10;• First segment fetch (init + media seg @95% CDN hit): 600 ms&#10;• Decoder warm-up + first decoded frame: 200 ms&#10;TOTAL p95 ≈ 1.8 s · 200 ms headroom" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="3160" y="120" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e_note_ttff" style="endArrow=none;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="note_ttff" target="play_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note_invariants" value="9 Key Invariants:&#10;1. CDN serves bytes; origin serves metadata (~95% CDN egress)&#10;2. One CMAF source · two manifests (HLS + DASH) — saves 50% storage&#10;3. Concurrent-stream limit enforced at LICENSE issuance, not play&#10;4. License issuance = single chokepoint · regional delegate certs&#10;5. Watch-progress eventually consistent across regions&#10;6. Subscription state STRONGLY consistent · CDC into Redis&#10;7. Manifest URLs short-lived (5 m TTL) signed HMAC&#10;8. Live ingest active/standby with seq-num persistence&#10;9. Every play emits audit.event (royalty + DRM compliance)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="3160" y="340" width="320" height="220" as="geometry" />
        </mxCell>

        <mxCell id="note_capacity" value="Back-of-envelope (peak):&#10;• 250 M registered · 50 M MAU · 10 M DAU&#10;• Avg concurrent: ~5–7 M VOD&#10;• Live final peak: ~50 M concurrent&#10;• Egress steady: ~35 Tbps · live: ~250 Tbps&#10;• Catalog: 50 K titles · ~600 M segs · 2.4 PB packaged&#10;• Mezzanine: ~5 PB&#10;• Watch-progress: 700 K writes/s sustained · 5 M/s live peak&#10;• DRM license issuance: 3 K/s peak · 350/s avg&#10;• Concurrent-stream Redis: ~300 MB in-memory&#10;• Encoding: ~500 GPU-h/day for 50 new title-h&#10;• Open-Connect appliances: ~15 K globally" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="3160" y="580" width="320" height="240" as="geometry" />
        </mxCell>

        <mxCell id="note_consistency" value="Consistency contract:&#10;• titles / users / subs: STRONG (Postgres) — write-through cache&#10;• subscription · DRM · concurrent-stream: STRONG · CDC to Redis&#10;• watch_progress · viewing_events: EVENTUAL (Cassandra)&#10;• reco rows: EVENTUAL (Redis · refreshed hourly)&#10;• ticks / qoe: best-effort fresh-or-die&#10;• catalog edits: STRONG on write · eventual to edge cache w/ TTL&#10;• audit log: STRONG (S3 WORM · 7 yr · studio audit ready)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="3160" y="840" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="note_drm" value="DRM matrix:&#10;• Widevine — Android · Chrome · ChromeOS · Cast · most TVs&#10;• PlayReady — Edge · Xbox · many TVs / STBs&#10;• FairPlay — iOS · macOS · tvOS · Safari (cbcs only)&#10;• CENC cbcs unifies all 3 with one ciphertext&#10;• Master keys in HSM · regional delegate signed daily&#10;• HDCP enforced for 4K · downscale to 1080p without HDCP&#10;• License = wrapped content key + policy (max-res · expiry · output)&#10;• Cached on device for session · &lt;200 ms p95 issuance" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="3160" y="1040" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="note_egress" value="CDN egress at scale:&#10;• 250 Tbps live peak (50 M × 5 Mbps)&#10;• 5 CDNs in parallel → no single PoP outage = 30% loss&#10;• Origin Shield collapses N edge requests → 1 origin pull&#10;• Pre-warm marquee titles to all PoPs ahead of release&#10;• Open-Connect appliances absorb long-tail (~50% in many ISPs)&#10;• CMCD next-object-request drives prefetch&#10;• DVR: 4-h rewind window · live → VOD post-event" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="3160" y="1260" width="320" height="180" as="geometry" />
        </mxCell>

        <!-- ============== FLOW LEGEND ============== -->

        <mxCell id="legend_box" value="Flow Legend (8 numbered, colour-coded flows)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=14;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="1700" width="2080" height="320" as="geometry" />
        </mxCell>

        <mxCell id="legend_B_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1750" as="sourcePoint" />
            <mxPoint x="180" y="1750" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_B_text" value="B — Browse Home (7 steps): Client → API GW → Catalog Svc + Recommendation Svc → Postgres + Redis (HGETALL home:{p}) → posters from CDN.   p95 ~ 200 ms." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="200" y="1735" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_P_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#C62828;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1785" as="sourcePoint" />
            <mxPoint x="180" y="1785" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_P_text" value="P — VOD Play (10 steps): POST /play → Playback Svc gates (subscription · concurrent-stream Lua CAS · DRM mint · manifest sign) → emit PLAY_START → CDN serves segments → on miss → Origin Shield → S3.   p95 TTFF ≤ 2 s." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="200" y="1770" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_L_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#4E342E;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1820" as="sourcePoint" />
            <mxPoint x="180" y="1820" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_L_text" value="L — Live Play (6 steps): Truck RTMP/SRT → Live Ingest (active+standby via etcd) → Live Transcoder (CMAF chunked 200 ms) → Origin Shield + S3 (DVR 4 h) + live.segments → CDN.   Glass-to-glass ~3–5 s." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#4E342E;" vertex="1" parent="1">
          <mxGeometry x="200" y="1805" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_H_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#EF6C00;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1855" as="sourcePoint" />
            <mxPoint x="180" y="1855" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_H_text" value="H — Heartbeat / Watch-Progress (6 steps): Player every 10 s → Heartbeat Svc → Kafka playback.heartbeat + ZADD streams (refresh) → Watch-Progress Writer → Cassandra UPSERT.   ~700 K writes/s sustained." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#EF6C00;" vertex="1" parent="1">
          <mxGeometry x="200" y="1840" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_C_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#00838F;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1890" as="sourcePoint" />
            <mxPoint x="180" y="1890" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_C_text" value="C — Concurrent-Stream Eviction (4 steps): Playback Lua CAS prunes + ZCARD → 5th device gets MAX_DEVICES → app prompts &quot;evict&quot; → POST /play?evict=true pops oldest → WS frame to old device (STREAM_EVICTED).   Source-of-truth: Redis ZSET." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#00838F;" vertex="1" parent="1">
          <mxGeometry x="200" y="1875" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_I_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1925" as="sourcePoint" />
            <mxPoint x="180" y="1925" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_I_text" value="I — Studio Ingest (15 steps): Studio uploads master to S3 mez → SQS → Workflow Orchestrator DAG → Encoder pool (×N rungs) + Audio/Subs/Thumb → Packager (CMAF + CENC cbcs · deposits content key at License Svc) → S3 packaged → QC (VMAF) → ingest.events PUBLISHED → Catalog UPDATE → catalog.events → Pre-warmer + Search Indexer + Notif." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="200" y="1910" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_R_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#6A1B9A;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1960" as="sourcePoint" />
            <mxPoint x="180" y="1960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_R_text" value="R — Recommendation (5 steps): Spark/Flink pipeline tails viewing.events + recommendation.feedback → trains DNN ranker (two-tower) + Top-10 → publishes home:{profile_id} to Redis HSET (TTL 1 h) → Reco Svc HGETALL → online re-rank (TF-Lite, last 5 plays) → 12 rows × 50 titles." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="200" y="1945" width="1860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend_D_arrow" style="endArrow=classic;html=1;rounded=0;strokeColor=#455A64;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="1995" as="sourcePoint" />
            <mxPoint x="180" y="1995" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_D_text" value="D — Multi-CDN Routing &amp; Audit (6 steps): Player beacons cdn.qoe → Flink CDN Router (30-s windows) computes weights (throughput · rebuffer · err · cost · cap) → writes etcd → Playback Svc reads on every play → manifest URL is rewritten to chosen CDN.  Every play also emits audit.events (license issued · session_id · geo) → S3 WORM 7 yr." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#455A64;" vertex="1" parent="1">
          <mxGeometry x="200" y="1980" width="1860" height="30" as="geometry" />
        </mxCell>

        <!-- Style legend (right side) -->
        <mxCell id="style_legend" value="Style Legend&#10;━━━━━━━━━━━━&#10;• Solid arrow  = data path on hot path&#10;• Dashed arrow = control / async / best-effort&#10;• Cylinder      = durable store / Kafka topic / index&#10;• Stacked rect = N-pod stateless service&#10;• Sticky note  = invariants &amp; trade-offs&#10;• Black box    = external system (CDN ISP, Studio, DRM CA)&#10;━━━━━━━━━━━━&#10;Color palette (from assets/README.md):&#10;• Blue   — stateless services / dispatchers&#10;• Green  — durable stores / DBs&#10;• Red    — caches / hot tiers / CDN&#10;• Purple — Kafka topics / streaming&#10;• Yellow — coordination / control plane / DRM / HSM&#10;• Orange — sweepers / safety nets / outbox" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="2200" y="1700" width="320" height="320" as="geometry" />
        </mxCell>

        <!-- Capacity / SLO summary panel -->
        <mxCell id="slo_panel" value="Capacity &amp; SLO summary:&#10;• 250 M registered · 50 M MAU · 10 M DAU&#10;• ~5–7 M concurrent VOD · 50 M peak (live final)&#10;• ~35 Tbps egress steady · 250 Tbps live peak&#10;• Catalog: 50 K titles · 600 M segs · 2.4 PB packaged&#10;• Mezzanine: ~5 PB · WORM · 11-9s in 3 regions&#10;• TTFF p95 ≤ 2 s · live glass-to-glass ≤ 5 s&#10;• Rebuffer ratio &lt; 0.4 % · search p95 ≤ 200 ms&#10;━━━━━━━━━━━━&#10;Tech stack (final verdict):&#10;• Postgres (titles · subscriptions) ·  Cassandra (watch progress)&#10;• Redis (sessions · streams · license · reco rows)&#10;• Kafka (RF=3 backbone) · Flink (real-time) · Spark (batch)&#10;• Akamai + CloudFront + Cloudflare + Limelight + OC appliances&#10;• Widevine + PlayReady + FairPlay (CENC cbcs) · HSM" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="2540" y="1700" width="320" height="320" as="geometry" />
        </mxCell>

        <!-- ============== AUTHOR / SOURCE FOOTER ============== -->
        <mxCell id="footer" value="Editable source · diagrams.net (drawio).  Open in Cursor with hediet.vscode-drawio extension.  See companion 05-DesignOTTPlatform.md (§8 HLD, §11 flows, §21 Q&amp;A) for box-by-box narrative." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="500" y="2080" width="2400" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
