        <mxCell id="model_store" value="Model Store&#10;(versioned)&#10;&#10;ranker DNN versions&#10;A/B-flag promotion&#10;TF Serving / Vertex AI" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
