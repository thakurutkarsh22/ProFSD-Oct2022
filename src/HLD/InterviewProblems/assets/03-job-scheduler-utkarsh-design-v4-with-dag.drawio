e__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;-- Sweeper, every few seconds:&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;UPDATE jobs&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;SET    &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;CANCELLED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, finished_at &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; NOW&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;()&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;WHERE  &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;CANCEL_REQUESTED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  AND  cancel_requested_at &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; NOW&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;()&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;-&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; INTERVAL &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;60 seconds&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Plus orchestrator action — if you can identify the worker pod (e.g.,&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-variable-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;worker_id&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;stored on the lease row), the Sweeper can call:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 26px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 26px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 36px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;kubectl delete pod $worker_id --grace-period=10&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;That sends&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;SIGTERM&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;(giving the user code 10 s to clean up), then&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;SIGKILL&lt;/code&gt;. Brutal but effective. The job row is already&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;CANCELLED&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;so any orphaned writes are at least logged loudly.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;This is opt-in; some users prefer &quot;let it finish&quot; over &quot;force kill&quot;. Make it a per-job-type flag.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The races (interviewer will probe these)&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Race 1 — Job finishes just as cancel arrives.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;Executor is committing&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;UPDATE … SET status='SUCCEEDED' WHERE id=X AND status='RUNNING'&lt;/code&gt;. Cancel API is committing&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;UPDATE … SET status='CANCEL_REQUESTED' WHERE id=X AND status='RUNNING'&lt;/code&gt;. Postgres serializes them via row lock. Whichever commits first wins; the loser gets&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;rows_affected = 0&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;and returns the appropriate result (&quot;too late to cancel&quot; or &quot;already cancelled, can't mark success&quot;).&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;No invalid state.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;✅&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Race 2 — Cancel arrives between Picker pop and Executor claim.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;Picker has popped the ZSET entry and produced to Kafka. Cancel CAS sets status to&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;CANCELLED&lt;/code&gt;. Executor pulls the Kafka message, runs&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;UPDATE … WHERE status='QUEUED'&lt;/code&gt;, finds 0 rows. Logs &quot;claim failed, presumed cancelled&quot;, drops the message. ✅&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Race 3 — Cancel sets the Redis flag, then the cancel txn rolls back.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;Phantom flag in Redis. Executor stops a job that wasn't actually cancelled.&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;This is the real bug to avoid.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The fix:&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;set the Redis flag&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;after&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;the Postgres txn commits&lt;/span&gt;, not before. Order matters:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 306px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 306px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 316px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 170);&quot;&gt;cancel&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;job_id&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;):&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;# 1. Authoritative state change (must succeed)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    rows &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; db&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;execute&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;UPDATE jobs SET status='CANCEL_REQUESTED' &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;                      &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;WHERE id=&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;%s&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt; AND status IN ('SCHEDULED','QUEUED','RUNNING')&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;,&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;                      job_id&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; rows &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;==&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;too_late&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    &lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;# 2. Fast-path notification (best-effort)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;try&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;        redis&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;set&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;&quot;cancel:&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;job_id&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;ex&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;3600&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    &lt;/sp