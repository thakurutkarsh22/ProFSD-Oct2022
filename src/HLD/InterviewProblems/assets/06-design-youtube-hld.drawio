        </mxCell>

        <mxCell id="search_index" value="Search Index&#10;(Elasticsearch / Vespa)&#10;&#10;BM25 + ANN (vectors)&#10;inverted index on title,&#10;desc, ASR captions, tags&#10;rebuild nightly + delta" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
