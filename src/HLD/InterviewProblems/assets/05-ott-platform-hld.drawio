        <mxCell id="e_b_reco_redis" value="B6: HGETALL home:{p}" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2;fontSize=11;fontColor=#1976D2;" edge="1" parent="1" source="reco_svc" target="redis_hot">
