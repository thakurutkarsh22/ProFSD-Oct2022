          <mxGeometry x="1790" y="860" width="540" height="40" as="geometry" />
        </mxCell>

        <mxCell id="leg_notes" value="Reading guide:&#10;&#10;• Solid arrows = data path  ·  Dashed arrows = control / leases / best-effort&#10;• Stacked rectangles = horizontally scaled clusters (N pods)&#10;• Shared paths (Client → API GW → Job Svc) labeled with multiple flow IDs&#10;• Step IDs: &lt;flow-letter&gt;&lt;step-number&gt;,  e.g. A3 = Flow A, step 3&#10;• Flow A is the canonical happy path. Flows B–F are variations or recoveries.&#10;• Flow G is the control-plane (lease management); arrows omitted from main diagram&#10;  for clarity — etcd connects to Watcher · Cron Emitter · Outbox Pub. · Sweeper · Picker.&#10;&#10;Step Sequence:&#10;&#10;A (Good / Scheduled, fire_at &gt; now):&#10;   A1 Client→APIGW · A2 APIGW→JobSvc · A3 JobSvc INSERT (Postgres txn)&#10;   A4 JobSvc ZADD…NX (best-effort, only if ≤ 5min)&#10;   A5 Watcher 1-min scan · A6 Watcher ZADD…NX (canonical promote)&#10;   A7 Picker Lua atomic pop · A8 Picker→Kafka produce&#10;   A9 Kafka→Consumer poll · A10 Consumer claim CAS · A11 Consumer→Executor&#10;   A12 Executor→Postgres SUCCEEDED&#10;&#10;B (Immediate / runNow): B3 INSERT job + outbox in 1 txn → B4 OutboxPub tails →&#10;   B5 produce to Kafka → reuse A9–A12&#10;&#10;C (Cancel): C3 CAS to CANCEL_REQUESTED → C4 SET cancel:{id} →&#10;   C5 Executor polls → C6 CAS to CANCELLED&#10;&#10;D (Error / Retry): D1 Executor on error: UPDATE→SCHEDULED, attempts++, backoff →&#10;   D3 produce to scheduler.dlq on max_attempts&#10;&#10;E (Cron):  E1 Executor INSERTS next + UPDATEs SUCCEEDED in SAME txn (primary)&#10;   E2 Cron Emitter scans for cron jobs missing future occurrence (safety net only)&#10;&#10;F (Sweeper): F1 Sweeper requeues stuck RUNNING jobs (lease expired) →&#10;    re-enters at A5" style="text;html=1;strokeColor=#cccccc;fillColor=#fafafa;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#222222;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1660" y="930" width="660" height="340" as="geometry" />
        </mxCell>

        <mxCell id="arr_entry1" value="A1 · B1 · C1: Submit / runNow / Cancel" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#333333;" edge="1" parent="1" source="client" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_entry2" value="A2 · B2 · C2: forward" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="jobsvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_a3" value="A3: INSERT job (txn, status=SCHEDULED)" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1976D2;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobsvc" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_a4" value="A4: ZADD…NX (best-effort, fire_at ≤ 5min)" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1976D2;dashed=1;dashPattern=4 4;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="jobsvc" target="redis_outer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_a5" value="A5 · D2 · F2: 1-min scan&#10;(5-min lookahead)" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1976D2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="watcher" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_a6" value="A6: ZADD…NX (canonical promote)" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1976D2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="watcher" target="redis_outer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_a7" value="A7: Lua atomic pop&#10;ZRANGEBYSCORE + ZREM" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1976D2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="picker" target="redis_outer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_a8" value="A8: produce&#10;key=job_id" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1976D2;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="picker" target="kafka_dispatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_a9" value="A9: poll" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1976D2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="kafka_dispatch" target="consumer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_a10" value="A10: claim CAS&#10;QUEUED → RUNNING + lease" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1976D2;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="consumer" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_a11" value="A11: dispatch" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#1976D2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="consumer" target="executor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_a12" value="A12: SUCCEEDED (terminal)" style="endArrow=classic;html=1;rounded=0;strokeColor=#1976D2;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1976D2;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="executor" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_b3" value="B3: INSERT job + outbox&#10;(SAME Postgres txn)" style="endArrow=classic;html=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#2E7D32;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobsvc" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_b4" value="B4: tail outbox" style="endArrow=classic;html=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#2E7D32;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="outbox_publisher" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_b5" value="B5: produce&#10;(at-least-once)" style="endArrow=classic;html=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#2E7D32;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="outbox_publisher" target="kafka_dispatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_c3" value="C3: CAS → CANCEL_REQUESTED" style="endArrow=classic;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#C62828;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobsvc" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_c4" value="C4: SET cancel:{id} EX 3600&#10;(fast, best-effort)" style="endArrow=classic;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#C62828;dashed=1;dashPattern=4 4;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="jobsvc" target="redis_cancel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_c5" value="C5: poll cancel:{id}&#10;every 1–5s during run" style="endArrow=classic;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#C62828;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="redis_cancel" target="executor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_c6" value="C6: CAS&#10;CANCEL_REQUESTED → CANCELLED" style="endArrow=classic;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#C62828;edgeStyle=orthogonalEdgeStyle;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="executor" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_d1" value="D1: UPDATE on error&#10;status → SCHEDULED&#10;attempts++, fire_at = now+backoff" style="endArrow=classic;html=1;rounded=0;strokeColor=#EF6C00;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#EF6C00;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="executor" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_d3" value="D3: produce to DLQ&#10;(max_attempts reached)" style="endArrow=classic;html=1;rounded=0;strokeColor=#EF6C00;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#EF6C00;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="executor" target="kafka_dlq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_e1" value="E1: INSERT next occurrence + UPDATE SUCCEEDED&#10;(SAME txn — primary cron path)" style="endArrow=classic;html=1;rounded=0;strokeColor=#6A1B9A;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#6A1B9A;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="executor" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_e2" value="E2: scan + insert missing next&#10;(safety net only — periodic)" style="endArrow=classic;html=1;rounded=0;strokeColor=#6A1B9A;strokeWidth=2;fontSize=11;fontStyle=2;fontColor=#6A1B9A;dashed=1;dashPattern=4 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cron_emitter" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_f1" value="F1: requeue stuck RUNNING&#10;WHERE lease_expires_at &lt; now()&#10;UPDATE → SCHEDULED" style="endArrow=classic;html=1;rounded=0;strokeColor=#4E342E;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#4E342E;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sweeper" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_g_etcd" value="G: shard leases&#10;(TTL=3s, hb=1s)" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#455A64;strokeWidth=1.5;fontSize=10;fontStyle=2;fontColor=#455A64;dashed=1;dashPattern=6 4;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="etcd" target="sweeper">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="v3 fixes from v1: Picker (100ms tick) replaces in-process timers · etcd shard leases for HA failover · Outbox Publisher kills dual-write · Executor inserts cron next-occurrence in same txn (Cron Emitter is safety net) · best-effort ZADD for sub-5-min latency, Watcher is canonical promoter" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1300" width="1580" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
