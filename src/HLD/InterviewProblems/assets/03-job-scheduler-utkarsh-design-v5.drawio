lt%3B%2Fspan%26gt%3Bis%20within%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bcode%20class%3D%26quot%3B%26quot%3B%20style%3D%26quot%3Bpadding%3A%201.5px%204px%3B%20border-radius%3A%205px%3B%20background-color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.08)%3B%20color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.94)%3B%20font-family%3A%20Menlo%2C%20Monaco%2C%20%26amp%3Bquot%3BCourier%20New%26amp%3Bquot%3B%2C%20monospace%3B%20font-size%3A%200.9em%3B%20line-height%3A%201.4%3B%20word-break%3A%20break-all%3B%26quot%3B%26gt%3B(Watcher_cadence%20%2B%20tick_jitter)%26lt%3B%2Fcode%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%E2%89%88%2090%20s.%20Beyond%20that%2C%20the%20Watcher%20will%20catch%20it%20before%20fire_at%2C%20so%20the%20optimization%20is%20wasted.%26lt%3B%2Fli%26gt%3B%26lt%3Bli%20class%3D%26quot%3Bpy-1%20%5B%26amp%3Bamp%3B%26amp%3Bgt%3Bp%5D%3Ainline%26quot%3B%20data-streamdown%3D%26quot%3Blist-item%26quot%3B%20style%3D%26quot%3Bpadding-block%3A%204px%3B%20word-break%3A%20break-word%3B%20padding%3A%200px%20!important%3B%26quot%3B%26gt%3B%26lt%3Bspan%20class%3D%26quot%3Bfont-semibold%26quot%3B%20data-streamdown%3D%26quot%3Bstrong%26quot%3B%20style%3D%26quot%3B--tw-font-weight%3A%20600%3B%20font-weight%3A%20600%3B%26quot%3B%26gt%3BSymmetric%20with%20the%20Watcher%20horizon%26lt%3B%2Fspan%26gt%3B%3A%205%20minutes%20matches%20the%20Watcher's%205-minute%20look-ahead.%20Using%20the%20same%20horizon%20means%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bem%26gt%3Bevery%20job%20in%20the%20hot%20horizon%20has%20both%20writers%26lt%3B%2Fem%26gt%3B%2C%20which%20simplifies%20the%20mental%20model.%20Going%20below%205%20min%20would%20create%20a%20band%20where%20Watcher%20is%20the%20only%20writer%2C%20and%20an%20even%20narrower%20band%20where%20Job%20Svc%20is%20also%20a%20writer%20%E2%80%94%20more%20cases%2C%20more%20bugs.%26lt%3B%2Fli%26gt%3B%26lt%3B%2Ful%26gt%3B%26lt%3Bp%20style%3D%26quot%3B--tw-space-y-reverse%3A%200%3B%20margin-block%3A%200px%2016px%3B%20margin%3A%206px%200px%3B%20word-break%3A%20break-word%3B%20color%3A%20rgb(204%2C%20204%2C%20204)%3B%20font-family%3A%20-apple-system%2C%20%26amp%3Bquot%3Bsystem-ui%26amp%3Bquot%3B%2C%20sans-serif%3B%20font-size%3A%2013px%3B%20font-style%3A%20normal%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20font-weight%3A%20400%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20white-space%3A%20normal%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3BReasonable%20alternative%3A%20drop%20the%20threshold%20to%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bcode%20class%3D%26quot%3B%26quot%3B%20style%3D%26quot%3Bpadding%3A%201.5px%204px%3B%20border-radius%3A%205px%3B%20background-color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.08)%3B%20color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.94)%3B%20font-family%3A%20Menlo%2C%20Monaco%2C%20%26amp%3Bquot%3BCourier%20New%26amp%3Bquot%3B%2C%20monospace%3B%20font-size%3A%200.9em%3B%20line-height%3A%201.4%3B%20word-break%3A%20break-all%3B%26quot%3B%26gt%3B%E2%89%A4%2090%20s%26lt%3B%2Fcode%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3Bif%20you%20want%20to%20minimize%20the%20dual-write%20surface%20area.%20Both%20are%20defensible.%26lt%3B%2Fp%26gt%3B%26lt%3Bh2%20class%3D%26quot%3Bmt-6%20mb-2%20font-semibold%20text-2xl%26quot%3B%20data-streamdown%3D%26quot%3Bheading-2%26quot%3B%20style%3D%26quot%3B--tw-space-y-reverse%3A%200%3B%20margin-block%3A%200px%2016px%3B%20margin-bottom%3A%2010px%3B%20--tw-font-weight%3A%20600%3B%20font-weight%3A%20600%3B%20color%3A%20rgb(204%2C%20204%2C%20204)%3B%20line-height%3A%201.25%3B%20font-size%3A%201.3em%3B%20margin-top%3A%2020px%3B%20font-family%3A%20-apple-system%2C%20%26amp%3Bquot%3Bsystem-ui%26amp%3Bquot%3B%2C%20sans-serif%3B%20font-style%3A%20normal%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20white-space%3A%20normal%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3B3.%20Why%20this%20dual-write%20is%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bem%26gt%3Bnot%26lt%3B%2Fem%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3Bthe%20same%20bug%20as%20v1%26lt%3B%2Fh2%26gt%3B%26lt%3Bp%20style%3D%26quot%3B--tw-space-y-reverse%3A%200%3B%20margin-block%3A%200px%2016px%3B%20margin%3A%206px%200px%3B%20word-break%3A%20break-word%3B%20color%3A%20rgb(204%2C%20204%2C%20204)%3B%20font-family%3A%20-apple-system%2C%20%26amp%3Bquot%3Bsystem-ui%26amp%3Bquot%3B%2C%20sans-serif%3B%20font-size%3A%2013px%3B%20font-style%3A%20normal%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20font-weight%3A%20400%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20white-space%3A%20normal%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3BThis%20is%20the%20question%20that%20matters.%20The%20v1%20bug%20was%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bcode%20class%3D%26quot%3B%26quot%3B%20style%3D