        <mxCell id="reco_pipe" value="Recommendation Pipeline&#10;(Spark · Flink · TensorFlow)&#10;&#10;feature pipeline (batch + stream)&#10;candidate-gen training&#10;ranker training (DNN two-tower)&#10;A/B framework&#10;publish to feature store + model store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
