        <mxCell id="e_l_xc_origin" value="L3: write 200-ms LL-HLS&#10;chunks + DVR (4 h)" style="endArrow=classic;html=1;rounded=0;strokeColor=#4E342E;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#4E342E;" edge="1" parent="1" source="live_xc" target="s3_packaged">
