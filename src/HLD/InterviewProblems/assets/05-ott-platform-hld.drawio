<mxfile host="app.diagrams.net" agent="cursor" version="24.0.0" type="device">
  <diagram name="OTT-Platform-HLD" id="hld-ott-1">
    <mxGraphModel dx="2400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============== TITLE ============== -->
        <mxCell id="title" value="Design an OTT Platform — High-Level Architecture&#10;(Netflix / Amazon Prime / Disney+ Hotstar · ~50 M concurrent live · ~5 PB packaged catalog · multi-CDN HLS+DASH with DRM)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="10" width="2200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Hot SLOs:  TTFF (time-to-first-frame) p95 ≤ 2 s · live glass-to-glass p95 ≤ 5 s · rebuffer ratio &lt; 0.4 % · DRM license issuance ~3 K/s peak · subscription/concurrent-stream STRONG · watch-progress EVENTUAL · per-region licensing windows" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="350" y="62" width="2700" height="22" as="geometry" />
        </mxCell>

        <!-- ============== ROW 1: CLIENTS ============== -->

        <mxCell id="client_mobile" value="Mobile App&#10;(iOS · Android)&#10;&#10;ExoPlayer / AVPlayer&#10;HLS · LL-HLS · DASH&#10;EME → DRM (Widevine /&#10;FairPlay)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="120" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="client_web" value="Web SPA&#10;(HTML5 + EME / MSE)&#10;&#10;hls.js · Shaka Player&#10;DASH + Widevine /&#10;PlayReady" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="client_tv" value="Smart TV / Console / STB&#10;(Tizen · WebOS · Roku ·&#10;Apple TV · Android TV ·&#10;Xbox / PS5)&#10;&#10;DASH 4K HDR · HDCP 2.2&#10;Widevine L1 · PlayReady" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="client_studio" value="Studio Upload Portal&#10;(internal editorial)&#10;&#10;multipart resumable S3&#10;200–500 GB ProRes / DNxHR&#10;sha256 client-side" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="client_truck" value="Production Truck / OB Van&#10;(live event source)&#10;&#10;SDI → encoded RTMP / SRT&#10;1080p60 · low-latency&#10;dual-publish (active+standby)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- ============== ROW 2: GLOBAL EDGE — Multi-CDN + Origin Shield + API GW + WS GW + Live Ingest + Auth ============== -->

        <!-- Multi-CDN group -->
        <mxCell id="cdn_group" value="Multi-CDN edge (Akamai · CloudFront · Cloudflare · Limelight + Open-Connect-style appliances at ISP) — serves ~95% of bytes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="290" width="1300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cdn_pop1" value="CDN Edge PoP&#10;(Akamai ·&#10;CloudFront · ~100 PoPs)&#10;&#10;~250 GB / PoP&#10;cache-hit ≥ 95%&#10;TLS · WAF · token-auth" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="330" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cdn_pop2" value="CDN Edge PoP&#10;(Cloudflare ·&#10;Limelight · region B)&#10;&#10;5 CDNs in parallel&#10;QoE-driven switching" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="340" y="330" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cdn_isp" value="Open-Connect Appliances&#10;(ISP-resident cache:&#10;Jio · Airtel · Comcast)&#10;&#10;~15 K appliances global&#10;256 TB / appliance&#10;long-tail egress saver" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="330" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cdn_shield" value="Origin Shield&#10;(per-region NGINX/Varnish)&#10;&#10;collapses 5 CDNs ×&#10;100 PoPs → 1 origin pull&#10;1–2 TB SSD / node&#10;~10 nodes / region&#10;hit ratio ≥ 99%" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="330" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cdn_note" value="Cache strategy:&#10;• Segments are immutable — Cache-Control: max-age=31536000, immutable&#10;• Manifests: VOD master 5 m · media 1 d · Live 1 s&#10;• Pre-warm marquee titles to all PoPs ahead of release&#10;• CMCD next-object-request hint → CDN pre-fetches seg N+1&#10;• Multi-CDN router updates weights every 30 s from cdn.qoe (Flink)&#10;• Signed URL: ?Expires=…&amp;Signature=HMAC(path|exp|user) · TTL 5 m" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="1040" y="320" width="320" height="160" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="api_gw_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1420" y="320" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="api_gw_back1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1410" y="310" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="api_gw" value="API Gateway / Edge LB&#10;(Envoy · multi-region active-active)&#10;&#10;TLS · OAuth2 · JWT validate&#10;per-user + per-IP rate limit&#10;MaxMind GeoIP → country&#10;Idempotency-Key (Redis 24 h)&#10;NEVER on segment path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="300" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- WebSocket Push Gateway -->
        <mxCell id="ws_gw_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1740" y="320" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ws_gw_back1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1730" y="310" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ws_gw" value="WS Push Gateway&#10;(M pods · sticky)&#10;&#10;eviction notice (5th device)&#10;live-event start ping&#10;notif fan-out · subscription&#10;heartbeat 15 s · resume cursor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1720" y="300" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Live Ingest Gateway -->
        <mxCell id="live_ingest_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="2020" y="320" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="live_ingest" value="Live Ingest Gateway&#10;(RTMP / SRT push)&#10;&#10;active + standby per event&#10;stream-key auth · seq check&#10;etcd lease (3-s failover)&#10;forwards to Live Transcoder" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2010" y="310" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Auth Service -->
        <mxCell id="auth" value="Auth Service&#10;(OAuth2 / OIDC)&#10;&#10;email · phone · SSO (Google/&#10;Apple/FB) · 2FA TOTP&#10;JWT 1 h · refresh 30 d&#10;session in Redis (revocable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4c3;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2300" y="300" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- User / Profile Service (top-right) -->
        <mxCell id="user_svc" value="User / Profile Service&#10;&#10;1 user → up to 5 profiles&#10;kid · parental PIN&#10;language pref · device list&#10;(Postgres backed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2580" y="300" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- ============== ROW 3: CORE SERVICES ============== -->

        <!-- Catalog Service -->
        <mxCell id="cat_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cat_back1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="110" y="530" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cat_svc" value="Catalog Service&#10;(stateless, N pods)&#10;&#10;GET /home /title/{id}&#10;multi-region read-replica&#10;hot title cached in Redis&#10;(TTL 1 h, per country)&#10;publishes catalog.events" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="520" width="220" height="130" as="geometry" />
        </mxCell>

        <!-- Search Service -->
        <mxCell id="search_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="380" y="540" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="search_back1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="370" y="530" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="search_svc" value="Search Service&#10;(stateless)&#10;&#10;ES / OpenSearch&#10;multi-language ICU + stem&#10;fuzzy · n-gram · voice&#10;BM25 × country × pop-decay&#10;per-region filter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="520" width="220" height="130" as="geometry" />
        </mxCell>

        <!-- Playback Service (the GATEKEEPER — emphasized) -->
        <mxCell id="play_back3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="650" y="550" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="play_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="640" y="540" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="play_back1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="630" y="530" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="play_svc" value="Playback Service ★ GATEKEEPER&#10;(Go · ~200 pods at peak)&#10;&#10;1. subscription / geo / window&#10;2. concurrent-stream Lua CAS&#10;3. DRM license mint (HSM-cached)&#10;4. sign manifest URL (HMAC, TTL 5 m)&#10;5. emit viewing.events.PLAY_START&#10;p95 ≤ 30 ms · only writer of license" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="520" width="280" height="140" as="geometry" />
        </mxCell>

        <!-- Recommendation Service -->
        <mxCell id="reco_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="970" y="540" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="reco_back1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="960" y="530" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="reco_svc" value="Recommendation Service&#10;(stateless)&#10;&#10;HGETALL home:{profile_id}&#10;12 rows × 50 titles&#10;online re-rank (TF-Lite)&#10;fallback: country/lang pop&#10;TTL 1 h · invalidated on publish" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="520" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Watchlist / History Service -->
        <mxCell id="wl_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1240" y="540" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="wl_svc" value="Watchlist / History&#10;Service&#10;&#10;GET/POST /watchlist&#10;continue-watching&#10;reads watch_progress&#10;writes Cassandra UPSERT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="530" width="220" height="130" as="geometry" />
        </mxCell>

        <!-- Subscription / Billing Service -->
        <mxCell id="sub_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1490" y="540" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sub_svc" value="Subscription / Billing&#10;(Stripe · Razorpay · Apple-IAP&#10;Google-Play · Amazon-IAP)&#10;&#10;plan = BASIC / STD / PREM&#10;webhook idempotency (UNIQUE)&#10;reconciler daily&#10;produces subscription.events" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1480" y="530" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- DRM License Server (its own service — emphasized as yellow) -->
        <mxCell id="drm_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1760" y="540" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="drm_svc" value="DRM License Server&#10;(Widevine · PlayReady · FairPlay)&#10;&#10;regional delegate certs&#10;(rotated daily from HSM)&#10;CENC cbcs · per-session blob&#10;policy: HDCP · max-res · expiry&#10;~3 K licenses/s peak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4c3;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1750" y="530" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Notification Service -->
        <mxCell id="notif_back2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="2030" y="540" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="notif_svc" value="Notification Service&#10;&#10;FCM / APNS / SES / Twilio&#10;subscription · new-release&#10;live-starting · billing-fail&#10;idempotent on event_id&#10;daily-digest dedupe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2020" y="530" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Live Transcoder + Packager (right side, separate live plane) -->
        <mxCell id="live_xc_back" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="2300" y="540" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="live_xc" value="Live Transcoder + Packager&#10;(NVENC GPU · LL-HLS / LL-DASH)&#10;&#10;CMAF chunked 200 ms&#10;keyframe interval = 1 s&#10;~3-5 s glass-to-glass&#10;writes to S3 (DVR 4 h)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2290" y="530" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Concurrent-Stream Counter (Redis annotation - small box) -->
        <mxCell id="csc_svc" value="Concurrent-Stream Counter&#10;(Redis · ZSET streams:{user})&#10;&#10;ZADD on play · prune on TTL&#10;TTL refreshed by heartbeat&#10;Lua CAS: ZCARD &gt;= max → reject&#10;source of truth for license eligibility" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2580" y="530" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Watch-Progress Heartbeat Service (right end, smaller) -->
        <mxCell id="hb_svc" value="Heartbeat / Watch-Progress&#10;Collector (stateless)&#10;&#10;POST /heartbeat (10 s)&#10;UPSERT Cassandra wp&#10;ZADD streams (refresh)&#10;produce playback.heartbeat" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2860" y="530" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- ============== ROW 4: KAFKA ASYNC BACKBONE ============== -->

        <mxCell id="kafka_group" value="Kafka cluster — async backbone (RF=3, acks=all, idempotent producer · per-region + cross-region MirrorMaker)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="730" width="3060" height="180" as="geometry" />
        </mxCell>

        <mxCell id="kf_viewing" value="viewing.events&#10;&#10;PLAY_START · STOP · PAUSE&#10;BITRATE_CHANGE · COMPLETE&#10;key = profile_id&#10;256 partitions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
