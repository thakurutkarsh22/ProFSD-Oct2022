        <mxCell id="e_l_ingest_etcd" value="leader lease (3-s TTL)" style="endArrow=classic;html=1;rounded=0;strokeColor=#4E342E;strokeWidth=1.5;fontSize=11;fontColor=#4E342E;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="live_ingest" target="etcd">
