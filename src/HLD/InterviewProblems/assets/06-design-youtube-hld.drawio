        </mxCell>

        <mxCell id="feature_store" value="Feature Store&#10;(online / offline)&#10;&#10;BigQuery (offline) +&#10;Bigtable (online)&#10;user · video · context features&#10;updated &lt; 1 min from event" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1680" y="1340" width="220" height="160" as="geometry" />
