        <mxCell id="comments_db" value="Comments / Likes&#10;(Bigtable / Cassandra)&#10;&#10;PK = (video_id, ts_desc)&#10;wide-row pagination&#10;shard by video_id&#10;eventually consistent" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="940" y="1340" width="220" height="160" as="geometry" />
        </mxCell>

        <mxCell id="counters_db" value="View Counters&#10;(Bigtable + Redis HLL)&#10;&#10;PK = (video_id, day)&#10;hot atomic INCR in Redis&#10;flush every 60 s to Bigtable&#10;HLL for unique-viewer counts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
