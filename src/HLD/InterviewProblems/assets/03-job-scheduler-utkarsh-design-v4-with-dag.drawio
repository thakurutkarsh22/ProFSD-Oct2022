quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;            FOR    UPDATE SKIP LOCKED   -- so multiple publisher pods don't fight&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&quot;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;for&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; row &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;in&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; rows&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;            future &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; kafka&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;produce&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;row&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;kafka_topic&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;key&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;row&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;kafka_key&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;value&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;row&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;kafka_payload&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;            future&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;get&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;timeout&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;5&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;       &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;# wait for Kafka ack&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;            db&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;execute&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;UPDATE outbox SET status='sent' WHERE id=&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;%s&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; row&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;id&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    sleep&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;0.05&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-scroll-area__scrollbar&quot; data-scrollable=&quot;true&quot; role=&quot;presentation&quot; aria-hidden=&quot;true&quot; style=&quot;position: absolute; z-index: 10; inset: auto 1px 1px; width: auto; pointer-events: auto; height: 6px;&quot;&gt;&lt;div class=&quot;ui-scroll-area__thumb&quot; style=&quot;position: absolute; inset: 0px auto 0px 0px; min-height: auto; width: 682px; border-radius: 9999px; background: none 0% 0% / auto repeat scroll padding-box border-box color(srgb 0.8 0.8 0.8 / 0.08); pointer-events: auto; transform: translateX(0px); transition: background-color 0.15s, opacity 0.15s; height: 6px; min-width: 20px; opacity: 0;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;ul class=&quot;list-inside list-disc whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;unordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: disc; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Pros&lt;/span&gt;: zero extra infrastructure, plain SQL, easy to operate.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Cons&lt;/span&gt;: ~50–500 ms polling lag added to your dispatch latency budget. Adds DB load (essentially you're tail-scanning a table forever).&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Flavor B — Debezium CDC (what the v2 diagram label says):&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 66px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 66px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 76px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;Postgres WAL  ──►  Debezium connector  ──►  Kafka Connect  ──►  Kafka topic&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;(logical                                                          (one event per&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt; replication)                                                       outbox INSERT)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Debezium reads the Postgres write-ahead log directly and emits a Kafka message for every committed row change in the outbox table. Sub-50ms commit-to-Kafka latency.&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Zero polling load on Postgres.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;But you need to operate Debezium + Kafka Connect.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;At our throughput target (10k jobs/s avg, 40k peak), I'd run CDC. Below ~1k/s, polling is fine and one less moving part.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;6. The &quot;exactly once&quot; claim — what it actually means&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The diagram label says&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;&quot;guarantees exactly once between Postgres &amp;amp; Kafka 2&quot;&lt;/em&gt;. This phrase is contentious in the Kafka world, so be precise about what's guaranteed:&lt;/p&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; --scrollbar-size: 6px; --scrollbar-inset: 0px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr; margin: 1em 0px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; border-radius: 6px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: auto; min-width: 100%; max-width: 100%; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;table style=&quot;color: inherit; font-size: inherit; border-collapse: collapse; width: max-content; min-width: 100%; --markdown-table-prose-cell-inline-size: 27ch;&quot;&gt;&lt;thead class=&quot;bg-muted/80&quot; data-streamdown=&quot;table-header&quot; style=&quot;background: none !important;&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;Property&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;Guaranteed?&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;How&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody class=&quot;divide-y divide-border bg-muted/40&quot; data-streamdown=&quot;table-body&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Every committed Postgres txn → ≥ 1 Kafka message&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Yes&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Outbox row is durable; publisher retries until ack.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Aborted Postgres txn → 0 Kafka messages&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Yes&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Outbox row was rolled back with the business write.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;No&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;duplicate Kafka messages on the wire&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;No&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Publisher can ack-then-crash. On restart it re-publishes.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;End-to-end exactly-once&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;effect&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;on consumer&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Yes, with idempotent consumer&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Use&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;kafka_key = job_id&lt;/code&gt;, dedupe on consumer side.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;So the right mental model is&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;&quot;at-least-once on the wire, exactly-once-effect end-to-end if your consumers dedupe by job_id&quot;&lt;/span&gt;. The outbox eliminates the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;Postgres-vs-Kafka atomicity&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;problem (which is unsolvable without coordination); it doesn't remove the need for idempotent consumers (which is a separate, easier problem solved by&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;key=job_id&lt;/code&gt;).&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;You can tighten the wire-level guarantee with&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Kafka idempotent producer (&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;enable.idempotence=true&lt;/code&gt;)&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;plus&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;transactional producer + read-committed isolation&lt;/span&gt;, which the publisher should use. But you still want the consumer-side dedupe as defense in depth.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;7. End-to-end walkthrough —&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;POST /jobs/{id}/runNow&lt;/code&gt;&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;User calls&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-variable-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;runNow&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;on job X. Trace:&lt;/p&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; --scrollbar-size: 6px; --scrollbar-inset: 0px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr; margin: 1em 0px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; border-radius: 6px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decora