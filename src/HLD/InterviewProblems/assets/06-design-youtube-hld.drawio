        </mxCell>

        <mxCell id="cold_storage" value="Cold / Archive&#10;(GCS Coldline / S3 Glacier)&#10;&#10;videos &gt;180 d &amp; &lt; 1 view/day&#10;evict from hot tier&#10;rehydrate on demand (~minutes)&#10;cost: 1/10th of hot" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
