color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;status='FAILED'&lt;/code&gt;, writes&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;outbox&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;row for&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-path-filename-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;&lt;span class=&quot;md-inline-path-filename&quot;&gt;job.failed&lt;/span&gt;&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;event&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Outbox Publisher → Kafka&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-path-filename-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;&lt;span class=&quot;md-inline-path-filename&quot;&gt;scheduler.dlq&lt;/span&gt;&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;topic for ops team / alerting&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quo