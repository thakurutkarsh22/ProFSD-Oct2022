        <mxCell id="creators_studio" value="Studio / Creator Tools&#10;(Avid · DaVinci · ProRes mastering)&#10;&#10;upload via portal&#10;reports: viewership · royalty&#10;creator dashboard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#cccccc;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2710" y="1500" width="240" height="160" as="geometry" />
