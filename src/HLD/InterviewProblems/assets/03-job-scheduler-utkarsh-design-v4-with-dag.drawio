4, 204, 204);&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;redis&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 170);&quot;&gt;call&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;ZREM&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;KEYS&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;], &lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 170);&quot;&gt;unpack&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;jobs&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;))&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;end&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;jobs&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Each returned&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-variable-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;job_id&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;is produced to topic&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-path-filename-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;&lt;span class=&quot;md-inline-path-filename&quot;&gt;jobs.run&lt;/span&gt;&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;with&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;key=job_id, acks=all&lt;/code&gt;.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Why the lease matters here:&lt;/p&gt;&lt;ul class=&quot;list-inside list-disc whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;unordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: disc; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Without the lease&lt;/span&gt;: even though the Lua is atomic and prevents&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;two&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;Pickers from claiming the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;same&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;job, you still get N·256 ticks/100ms = ~2.5k·N idle ticks/sec. That's wasted Redis CPU and adds tail latency to legitimate ZADD/ZREM operations on the same key (Redis is single-threaded per key).&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Without the lease, second risk&lt;/span&gt;: the produce-to-Kafka step is&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;not&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;inside the Lua. So two Pickers calling Lua back-to-back on the same shard might&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;both&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;succeed for distinct jobs in the same window, but if you ever weakened the Lua to a non-atomic ZRANGEBYSCORE+ZREM pair, you'd get&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;double dispatch&lt;/span&gt;. The lease is defense-in-depth: even if someone refactors the Lua poorly later, only one pod is ticking the shard, so only one can produce.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;With the lease&lt;/span&gt;: 256 ticks/100ms regardless of pod count. The 100 ms tick budget actually has slack to do real work.&lt;/li&gt;&lt;/ul&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;6. Why I usually co-locate Watcher + Picker in the same pod&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;In the diagram they're separate boxes for clarity. In production I'd typically:&lt;/p&gt;&lt;ul class=&quot;list-inside list-disc whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;unordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: disc; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Run&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;one binary&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;that is both Watcher and Picker.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;That binary acquires&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;one lease per shard&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in etcd.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;For each owned shard, it runs the 1-min pre-load loop AND the 100-ms tick loop in the same process.&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Why:&lt;/p&gt;&lt;ol class=&quot;list-inside list-decimal whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;ordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: decimal; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;They share the same shard ownership decision, so one lease is enough.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Co-located, the pre-loader and picker share Redis connections to the same&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;due:{shard}&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;key — better connection reuse.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Avoids the failure mode where the Watcher lease holder is alive but the Picker lease holder is dead, leaving the ZSET filling but not draining.&lt;/li&gt;&lt;/ol&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The diagram still shows them separately because some teams prefer the clean separation of concerns and run them as two deployments, both leasing the same shards from the same etcd. Either is defensible&lt;/p&gt;" id="67"><mxCell parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1"><mxGeometry height="3290" width="560" x="5910" y="1900" as="geometry"/></mxCell></UserObject><mxCell id="68" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;7. What happens if etcd itself is unavailable?&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;This is the standard &quot;control plane vs data plane&quot; question.&lt;/p&gt;&lt;ul class=&quot;list-inside list-disc whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;unordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: disc; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Existing leases keep working&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;until they expire (etcd has Raft quorum loss requirements; if a single etcd node dies, the cluster keeps serving). Most etcd outages are ≤ 30 s rolling restarts, well within an existing lease's life if you size TTL large enough — but I deliberately chose a&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;small&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;TTL (3 s) for fast failover, which trades resilience to etcd outage for dispatch precision.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;If etcd is fully unavailable for &amp;gt; TTL: leases expire, no pod can renew or grab new leases, and dispatch&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;halts cleanly&lt;/span&gt;. We do&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;not&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;fall back to &quot;everyone scan everything&quot; because that risks double-dispatch.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;During halt, jobs continue to accumulate in Postgres. Once etcd recovers, leases get re-acquired and dispatch resumes; the only impact is that the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;fire_at&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;deadline of jobs that came due during the outage is missed. We accept that — etcd is a documented control-plane dependency in our SLA.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Mitigation: run etcd as a 5-node cluster across 3 AZs, treat it as a tier-0 dependency (same blast radius as Postgres).&lt;/li&gt;&lt;/ul&gt;" vertex="1"><mxGeometry height="340" width="560" x="5910" y="4540" as="geometry"/></mxCell><UserObject label="&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;1. The problem the Cron Emitter solves&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;A cron job (e.g.&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;0 * * * *&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;= every hour) has to fire repeatedly. We have two naive options that both break:&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Naive A — pre-compute all future occurrences as rows.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;For&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;* * * * *&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;over a year that's ~525k rows per cron job. Bounded only if you cap horizon, but then you have to re-bulk-insert when the horizon advances. Operationally awful, and you have to migrate every time the cron expression changes.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Naive B — when the current run finishes, insert the next occurrence.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;Correct shape. But the sub-question is&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;exactly when&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in the lifecycle do you do that insert, and&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;who&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;does it? The wrong choices give you silent cron death:&lt;/p&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; --scrollbar-size: 6px; --scrollbar-inset: 0px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr; margin: 1em 0px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; border-radius: 6px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: auto; min-width: 100%; max-width: 100%; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;table style=&quot;color: inherit; font-size: inherit; border-collapse: collapse; width: max-content; min-width: 100%; --markdown-table-prose-cell-inline-size: 40ch;&quot;&gt;&lt;thead class=&quot;bg-muted/80&quot; data-streamdown=&quot;table-header&quot; style=&quot;background: none !important;&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;Where you do it&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;Failure mode&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody class=&quot;divide-y divide-border bg-muted/40&quot; data-streamdown=&quot;table-body&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Inside the executor, after the user code returns&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Executor crashes / is killed / OOMs after running but before inserting → cron schedule dies forever, no next row exists.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Inside the Watcher when promoting the row to Redis&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Way too early — you'd have a &quot;next&quot; row before this run even started; cancellations and retries get messy.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Inside the Status Consumer right after&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;UPDATE status='SUCCEEDED'&lt;/code&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Two separate writes. Status Consumer crashes between them → row is&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;SUCCEEDED&lt;/code&gt;, no next occurrence exists,&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;cron is permanently dead and looks healthy&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;(most insidious).&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The whole reason this is a dedicated component in the diagram is to make the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;transactional ordering&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;of those two writes a first-class invariant.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;2. The invariant the Cron Emitter enforces&lt;/h2&gt;&lt;blockquote class=&quot;my-4 border-muted-foreground/30 border-l-4 pl-4 text-muted-foreground italic&quot; data-streamdown=&quot;blockquote&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; padding: 8px 0px 8px 16px; font-style: italic; margin: 0.5rem 0px; border-left: 2.91667px solid color(srgb 0.8 0.8 0.8 / 0.12); background: rgb(31, 31, 31); color: rgb(204, 204, 204); word-break: break-word; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;p style=&quot;margin: 0px; word-break: break-word;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;A cron occurrence cannot reach&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;SUCCEEDED&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;until the next occurrence's row exists in&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;jobs&lt;/code&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Concretely, in&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;one Postgres transaction&lt;/span&gt;:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 326px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 326px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 336px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;BEGIN;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;-- 1. compute next fire time from cron_expr (with timezone)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;-- 2. insert the next occurrence FIRST&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  INSERT INTO jobs (id, tenant_id, cron_expr, fire_at_ms, fire_minute,&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;                    shard, schedule_type, &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, payload, ...)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  VALUES (:next_id, :tenant, :cron, :next_fire, :next_min,&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;          :shard, &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;CRON&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;SCHEDULED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, :payload, ...);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;-- 3. write the outbox event for the next occurrence (publish to Kafka 2)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  INSERT INTO outbox (job_id, kafka_topic, kafka_key, kafka_payload, &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  VALUES (:next_id, &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;jobs.lifecycle&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, :next_id, :&lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;event&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;pending&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;-- 4. ONLY THEN mark current run done&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  UPDATE jobs SET &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;SUCCEEDED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;version&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;version&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;+&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;1&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  WHERE id &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; :current_id AND &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;RUNNING&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;COMMIT;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;That's it. Eager-emit the next row first, then close the current one, in a single ACID txn. That's why the diagram label says&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;&quot;INSERT next row EAGERLY before SUCCEEDED is set&quot;&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;— eager (not lazy) is what makes it crash-safe.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;If the Cron Emitter dies mid-transaction, nothing committed → the current row is still&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;RUNNING&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;→ the Stuck-IN_FLIGHT Sweeper (cell 66) will reset it to&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;SCHEDULED&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;→ it gets re-dispatched (executor is idempotent on&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-variable-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;job_id&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;so the user code is safe to re-run, or the next attempt will succeed). The cron schedule is&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;never lost&lt;/span&gt;.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;3. Where it sits in the pipeline&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Following arrows from the v2 diagram:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 66px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 66px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 76px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;Executor → Kafka jobs.status → Status Consumer ──[if cron]──► Cron Emitter ──► Postgres&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                                                                  │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                                                                  └─► outbox → Kafka 2 (next occurrence's lifecycle event)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-scroll-area__scrollbar&quot; data-scrollable=&quot;true&quot; role=&quot;presentation&quot; aria-hidden=&quot;true&quot; style=&quot;position: absolute; z-index: 10; inset: auto 1px 1px; width: auto; pointer-events: auto; height: 6px;&quot;&gt;&lt;div class=&quot;ui-scroll-area__thumb&quot; style=&quot;position: absolute; inset: 0px auto 0px 0px; min-height: auto; width: 472px; border-radius: 9999px; background: none 0% 0% / auto repeat scroll padding-box border-box color(srgb 0.8 0.8 0.8 / 0.08); pointer-events: auto; transform: translateX(0px); transition: background-color 0.15s, opacity 0.15s; height: 6px; min-width: 20px; opacity: 0;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The Status Consumer handles the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;common&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;case (write the status update + audit row to Postgres). For cron jobs in a terminal state, it routes to the Cron Emitter, which owns the eager-insert-of-next-row + close-current invariant. They could be the same process; in the diagram I drew them separately so the invariant has its own box.&lt;/p&gt;" link="&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;1. The problem the Cron Emitter solves&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;A cron job (e.g.&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;0 * * * *&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;= every hour) has to fire repeatedly. We have two naive options that both break:&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Naive A — pre-compute all future occurrences as rows.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;For&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;* * * * *&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;over a year that's ~525k rows per cron job. Bounded only if you cap horizon, but then you have to re-bulk-insert when the horizon advances. Operationally awful, and you have to migrate every time the cron expression changes.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Naive B — when the current run finishes, insert the next occurrence.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;Correct shape. But the sub-question is&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;exactly when&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in the lifecycle do you do that insert, and&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;who&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;does it? The wrong choices give you silent cron death:&lt;/p&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; --scrollbar-size: 6px; --scrollbar-inset: 0px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr; margin: 1em 0px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; border-radius: 6px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: auto; min-width: 100%; max-width: 100%; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;table style=&quot;color: inherit; font-size: inherit; border-collapse: collapse; width: max-content; min-width: 100%; --markdown-table-prose-cell-inline-size: 40ch;&quot;&gt;&lt;thead class=&quot;bg-muted/80&quot; data-streamdown=&quot;table-header&quot; style=&quot;background: none !important;&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;Where you do it&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;Failure mode&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody class=&quot;divide-y divide-border bg-muted/40&quot; data-streamdown=&quot;table-body&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Inside the executor, after the user code returns&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Executor crashes / is killed / OOMs after running but before inserting → cron schedule dies forever, no next row exists.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Inside the Watcher when promoting the row to Redis&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Way too early — you'd have a &quot;next&quot; row before this run even started; cancellations and retries get messy.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Inside the Status Consumer right after&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;UPDATE status='SUCCEEDED'&lt;/code&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Two separate writes. Status Consumer crashes between them → row is&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;SUCCEEDED&lt;/code&gt;, no next occurrence exists,&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;cron is permanently dead and looks healthy&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;(most insidious).&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The whole reason this is a dedicated component in the diagram is to make the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;transactional ordering&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;of those two writes a first-class invariant.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;2. The invariant the Cron Emitter enforces&lt;/h2&gt;&lt;blockquote class=&quot;my-4 border-muted-foreground/30 border-l-4 pl-4 text-muted-foreground italic&quot; data-streamdown=&quot;blockquote&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; padding: 8px 0px 8px 16px; font-style: italic; margin: 0.5rem 0px; border-left: 2.91667px solid color(srgb 0.8 0.8 0.8 / 0.12); background: rgb(31, 31, 31); color: rgb(204, 204, 204); word-break: break-word; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;p style=&quot;margin: 0px; word-break: break-word;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;A cron occurrence cannot reach&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;SUCCEEDED&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;until the next occurrence's row exists in&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;jobs&lt;/code&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Concretely, in&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;one Postgres transaction&lt;/span&gt;:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 326px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 326px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 336px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;BEGIN;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;-- 1. compute next fire time from cron_expr (with timezone)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;-- 2. insert the next occurrence FIRST&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  INSERT INTO jobs (id, tenant_id, cron_expr, fire_at_ms, fire_minute,&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;                    shard, schedule_type, &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, payload, ...)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  VALUES (:next_id, :tenant, :cron, :next_fire, :next_min,&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;          :shard, &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;CRON&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;SCHEDULED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, :payload, ...);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;-- 3. write the outbox event for the next occurrence (publish to Kafka 2)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  INSERT INTO outbox (job_id, kafka_topic, kafka_key, kafka_payload, &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  VALUES (:next_id, &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;jobs.lifecycle&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, :next_id, :&lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;event&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;pending&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;-- 4. ONLY THEN mark current run done&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  UPDATE jobs SET &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;SUCCEEDED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;version&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;version&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;+&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;1&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  WHERE id &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; :current_id AND &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;RUNNING&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;COMMIT;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;That's it. Eager-emit the next row first, then close the current one, in a single ACID txn. That's why the diagram label says&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;&quot;INSERT next row EAGERLY before SUCCEEDED is set&quot;&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;— eager (not lazy) is what makes it crash-safe.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;If the Cron Emitter dies mid-transaction, nothing committed → the current row is still&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;RUNNING&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;→ the Stuck-IN_FLIGHT Sweeper (cell 66) will reset it to&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;SCHEDULED&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;→ it gets re-dispatched (executor is idempotent on&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-variable-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;job_id&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;so the user code is safe to re-run, or the next attempt will succeed). The cron schedule is&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;never lost&lt;/span&gt;.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;3. Where it sits in the pipeline&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Following arrows from the v2 diagram:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 66px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 66px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 76px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;Executor → Kafka jobs.status → Status Consumer ──[if cron]──► Cron Emitter ──► Postgres&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                                                                  │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                                                                  └─► outbox → Kafka 2 (next occurrence's lifecycle event)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-scroll-area__scrollbar&quot; data-scrollable=&quot;true&quot; role=&quot;presentation&quot; aria-hidden=&quot;true&quot; style=&quot;position: absolute; z-index: 10; inset: auto 1px 1px; width: auto; pointer-events: auto; height: 6px;&quot;&gt;&lt;div class=&quot;ui-scroll-area__thumb&quot; style=&quot;position: absolute; inset: 0px auto 0px 0px; min-height: auto; width: 472px; border-radius: 9999px; background: none 0% 0% / auto repeat scroll padding-box border-box color(srgb 0.8 0.8 0.8 / 0.08); pointer-events: auto; transform: translateX(0px); transition: background-color 0.15s, opacity 0.15s; height: 6px; min-width: 20px; opacity: 0;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The Status Consumer handles the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;common&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;case (write the status update + audit row to Postgres). For cron jobs in a terminal state, it routes to the Cron Emitter, which owns the eager-insert-of-next-row + close-current invariant. They could be the same process; in the diagram I drew them separately so the invariant has its own box.&lt;/p&gt;" id="69"><mxCell parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1"><mxGeometry height="1380" width="560" x="6490" y="1900" as="geometry"/></mxCell></UserObject><UserObject label="&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;1. The bug it fixes (the dual-write problem)&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;In your v1 whiteboard there was an arrow&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;Job Svc → Kafka 2&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;for fast/immediate jobs. That's the classic&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;dual-write problem&lt;/span&gt;, and it's broken. Conceptually the Job Service was doing this:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 86px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 86px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 96px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 170);&quot;&gt;submit&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;job&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;):&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    db&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;execute&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;INSERT INTO jobs (...) VALUES (...)&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;# write 1: Postgres&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; job&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;fire_at &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&amp;lt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; now&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;()&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;+&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; 5_min&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;        kafka&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;produce&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;jobs.run&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; job&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;                   &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;# write 2: Kafka&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;These are two independent writes to two independent systems with no coordinator between them. Walk through the failure modes:&lt;/p&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; --scrollbar-size: 6px; --scrollbar-inset: 0px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr; margin: 1em 0px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; border-radius: 6px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: auto; min-width: 100%; max-width: 100%; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;table style=&quot;color: inherit; font-size: inherit; border-collapse: collapse; width: max-content; min-width: 100%; --markdown-table-prose-cell-inline-size: 40ch;&quot;&gt;&lt;thead class=&quot;bg-muted/80&quot; data-streamdown=&quot;table-header&quot; style=&quot;background: none !important;&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;What happens&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;Result&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody class=&quot;divide-y divide-border bg-muted/40&quot; data-streamdown=&quot;table-body&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Postgres commits, Kafka fails&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Row exists in DB, no dispatch ever happens.&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Silent job loss.&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Postgres rolls back, Kafka already produced&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Phantom dispatch with no source-of-truth row.&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Phantom run.&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Postgres commits, process crashes before&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-path-filename-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;&lt;span class=&quot;md-inline-path-filename&quot;&gt;kafka.produce&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Same as case 1. Silent loss.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Kafka producer ack times out, app retries, both produces actually succeeded&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Duplicate dispatch.&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Network split between app and Kafka after Postgres commit&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 327.539px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Same as case 1.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;There is no way to fix this with retry logic. You need either:&lt;/p&gt;&lt;ol class=&quot;list-inside list-decimal whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;ordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: decimal; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;2-phase commit / XA transactions across Postgres + Kafka&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;— possible, fragile, performance disaster.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;The transactional outbox pattern&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;— what v2 does.&lt;/li&gt;&lt;/ol&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;2. The transactional outbox pattern in one paragraph&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Instead of writing to Kafka directly, the Job Service writes the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;intent to publish&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;as a row in a normal Postgres table called&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;outbox&lt;/code&gt;,&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;inside the same transaction&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;as the business write. Postgres gives you ACID atomicity for free between the two rows in the same transaction. Then a&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;separate process&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;— the Outbox Publisher — tails the outbox table and is the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;only thing&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;that actually talks to Kafka. The outbox row is the durable, crash-safe record of &quot;this message must reach Kafka eventually.&quot;&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 526px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 526px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 536px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                 ┌────────── ONE Postgres transaction ──────────┐&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                 │                                              │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;Job Svc  ───────►│  INSERT INTO jobs   (id, fire_at, status, …) │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                 │  INSERT INTO outbox (job_id, topic, key,     │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                 │                      payload, 'pending')     │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                 │  COMMIT                                      │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                 └──────────────────────────────────────────────┘&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                     │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                     ▼&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              ┌──────────────┐&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              │   outbox     │  (durable in Postgres)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              │  table       │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              └──────┬───────┘&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                     │  Debezium CDC (or poll)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                     ▼&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              ┌──────────────┐&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              │   Outbox     │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              │  Publisher   │  ◄── this is the (NEW) box&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              └──────┬───────┘&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                     │  produce, acks=all,&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                     │  enable.idempotence=true&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                                     ▼&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              ┌──────────────┐&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              │   Kafka 2    │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              │  jobs.run    │&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;                              └──────────────┘&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Postgres is now the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;single source of truth for &quot;did this happen&quot;&lt;/span&gt;. Kafka is just the transport. If the message reaches Kafka, great. If not yet, the outbox row says so and the publisher will retry until it does.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;3. Where it's used in v2 (and where it's NOT used)&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;This is the most-misunderstood part of the diagram, so let me be explicit.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;The hot dispatch path for&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;future&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;jobs does NOT go through the outbox.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;That path is:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 26px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 26px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 36px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;Job Svc ─INSERT─► Postgres ─Watcher scan─► Redis ZSET ─Picker tick─► Kafka 2 ─consume─► Executor&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-scroll-area__scrollbar&quot; data-scrollable=&quot;true&quot; role=&quot;presentation&quot; aria-hidden=&quot;true&quot; style=&quot;position: absolute; z-index: 10; inset: auto 1px 1px; width: auto; pointer-events: auto; height: 6px;&quot;&gt;&lt;div class=&quot;ui-scroll-area__thumb&quot; style=&quot;position: absolute; inset: 0px auto 0px 0px; min-height: auto; width: 674px; border-radius: 9999px; background: none 0% 0% / auto repeat scroll padding-box border-box color(srgb 0.8 0.8 0.8 / 0.08); pointer-events: auto; transform: translateX(0px); transition: background-color 0.15s, opacity 0.15s; height: 6px; min-width: 20px; opacity: 0;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The Picker is the producer to Kafka 2 in steady state. The outbox isn't on that path — it would add unnecessary latency to a path that already has the Picker doing the produce.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;The outbox is used for the four cases that&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;don't&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;fit the &quot;wait until fire_at&quot; pattern:&lt;/span&gt;&lt;/p&gt;&lt;ol class=&quot;list-inside list-decimal whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;ordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: decimal; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;p style=&quot;margin: 0px; word-break: break-word;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;POST /jobs/{id}/runNow&lt;/code&gt;&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;— user wants the job to fire&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;right now&lt;/em&gt;. Can't wait for the 1-min Watcher tick. Job Svc must produce to Kafka 2 immediately. Going direct is the v1 bug → use outbox.&lt;/p&gt;&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;p style=&quot;margin: 0px; word-break: break-word;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Submit with&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;fire_at ≤ now&lt;/code&gt;&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;(immediate jobs). Same logic as runNow.&lt;/p&gt;&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;p style=&quot;margin: 0px; word-break: break-word;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Reconciliation / failsafe.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;If a job is stuck in&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;QUEUED&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in Postgres but for some reason isn't in the Redis ZSET (hot tier was wiped, Watcher fell behind, Picker crashed for that shard) → some reconciler inserts into outbox → publisher re-emits to Kafka 2. This is the &quot;republish (failsafe)&quot; arrow on the diagram.&lt;/p&gt;&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;&lt;p style=&quot;margin: 0px; word-break: break-word;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Job lifecycle events for downstream consumers.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;Billing, audit, search indexing, customer-facing webhooks, etc. all want to know when a job was created, succeeded, failed. Those events go through the outbox so they're never lost.&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;For all four cases, the property &quot;Postgres commit ⟺ Kafka eventually receives the message&quot; is the value the outbox is providing.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;4. What an outbox row looks like&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;From the diagram (cell 16):&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 206px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 206px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 216px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-stri