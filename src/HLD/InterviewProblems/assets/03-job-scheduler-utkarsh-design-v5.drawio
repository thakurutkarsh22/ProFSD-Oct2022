20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3B11.%20The%20one-line%20summary%20for%20an%20interview%26lt%3B%2Fh2%26gt%3B%26lt%3Bblockquote%20class%3D%26quot%3Bmy-4%20border-muted-foreground%2F30%20border-l-4%20pl-4%20text-muted-foreground%20italic%26quot%3B%20data-streamdown%3D%26quot%3Bblockquote%26quot%3B%20style%3D%26quot%3B--tw-space-y-reverse%3A%200%3B%20margin-block%3A%200px%2016px%3B%20padding%3A%208px%200px%208px%2016px%3B%20font-style%3A%20italic%3B%20margin%3A%200.5rem%200px%3B%20border-left%3A%202.91667px%20solid%20color(srgb%200.8%200.8%200.8%20%2F%200.12)%3B%20background%3A%20rgb(31%2C%2031%2C%2031)%3B%20color%3A%20rgb(204%2C%20204%2C%20204)%3B%20word-break%3A%20break-word%3B%20font-family%3A%20-apple-system%2C%20%26amp%3Bquot%3Bsystem-ui%26amp%3Bquot%3B%2C%20sans-serif%3B%20font-size%3A%2013px%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20font-weight%3A%20400%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20white-space%3A%20normal%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3B%26lt%3Bp%20style%3D%26quot%3Bmargin%3A%200px%3B%20word-break%3A%20break-word%3B%26quot%3B%26gt%3B%26lt%3Bem%26gt%3B%26quot%3BThe%20Outbox%20Publisher%20exists%20because%20writing%20to%20Postgres%20and%20producing%20to%20Kafka%20in%20two%20separate%20steps%20is%20unsafe%20%E2%80%94%20any%20crash%20between%20them%20causes%20silent%20data%20loss%20or%20phantom%20events.%20We%20instead%20write%20the%20dispatch%20intent%20into%20an%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bcode%20class%3D%26quot%3B%26quot%3B%20style%3D%26quot%3Bpadding%3A%201.5px%204px%3B%20border-radius%3A%205px%3B%20background-color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.08)%3B%20color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.94)%3B%20font-family%3A%20Menlo%2C%20Monaco%2C%20%26amp%3Bquot%3BCourier%20New%26amp%3Bquot%3B%2C%20monospace%3B%20font-size%3A%200.9em%3B%20line-height%3A%201.4%3B%20word-break%3A%20break-all%3B%26quot%3B%26gt%3Boutbox%26lt%3B%2Fcode%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3Btable%20in%20the%20same%20Postgres%20transaction%20as%20the%20business%20row%2C%20and%20a%20separate%20publisher%20process%20(Debezium%20CDC)%20tails%20the%20outbox%20and%20produces%20to%20Kafka%20with%20idempotent%20producer%20%2B%20acks%3Dall.%20That%20gives%20us%20atomicity%20between%20Postgres%20and%20Kafka%20with%20at-least-once%20delivery%20on%20the%20wire%2C%20plus%20exactly-once-effect%20downstream%20because%20every%20Kafka%20message%20is%20keyed%20by%20job_id%20and%20consumers%20dedupe%20with%20a%20CAS%20on%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bcode%20class%3D%26quot%3Bmd-inline-path-filename-like%26quot%3B%20style%3D%26quot%3Bpadding%3A%201.5px%204px%3B%20border-radius%3A%205px%3B%20background-color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.08)%3B%20color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.94)%3B%20font-family%3A%20Menlo%2C%20Monaco%2C%20%26amp%3Bquot%3BCourier%20New%26amp%3Bquot%3B%2C%20monospace%3B%20font-size%3A%200.9em%3B%20line-height%3A%201.4%3B%20word-break%3A%20break-all%3B%26quot%3B%26gt%3B%26lt%3Bspan%20class%3D%26quot%3Bmd-inline-path-filename%26quot%3B%26gt%3Bjobs.status%26lt%3B%2Fspan%26gt%3B%26lt%3B%2Fcode%26gt%3B.%26quot%3B%26lt%3B%2Fem%26gt%3B%26lt%3B%2Fp%26gt%3B%26lt%3B%2Fblockquote%26gt%3B%22%20id%3D%2270%22%3E%3CmxCell%20parent%3D%221%22%20style%3D%22text%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3BfillColor%3D%23f8cecc%3BstrokeColor%3D%23b85450%3B%22%20vertex%3D%221%22%3E%3CmxGeometry%20height%3D%225270%22%20width%3D%22560%22%20x%3D%226330%22%20y%