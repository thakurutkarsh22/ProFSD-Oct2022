        </mxCell>
        <mxCell id="kf_heartbeat" value="playback.heartbeat&#10;&#10;every 10 s · ephemeral&#10;throughput · buffer · rebuffer&#10;key = session_id&#10;64 partitions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
