        <mxCell id="redis_hot" value="Redis Hot Cache&#10;&#10;video metadata (TTL 5 m)&#10;reco lists per user (TTL 5 m)&#10;view counters (atomic INCR)&#10;rate-limit token buckets&#10;session lookups" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
