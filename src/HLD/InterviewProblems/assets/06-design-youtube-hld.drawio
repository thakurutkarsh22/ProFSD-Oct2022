        <mxCell id="meta_db" value="Video Metadata DB&#10;(Spanner / Vitess)&#10;&#10;videos · channels · users&#10;global secondary indexes&#10;sharded by video_id&#10;strong consistency" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
