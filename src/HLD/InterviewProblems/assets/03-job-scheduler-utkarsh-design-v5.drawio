e-space%3A%20normal%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3BSo%20this%20is%20a%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bspan%20class%3D%26quot%3Bfont-semibold%26quot%3B%20data-streamdown%3D%26quot%3Bstrong%26quot%3B%20style%3D%26quot%3B--tw-font-weight%3A%20600%3B%20font-weight%3A%20600%3B%26quot%3B%26gt%3Bperformance%20optimization%20on%20top%20of%20a%20self-healing%20primary%20path%26lt%3B%2Fspan%26gt%3B%2C%20not%20a%20correctness%20mechanism.%20The%20diagram%20makes%20that%20explicit%20by%20labeling%20the%20arrow%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bcode%20class%3D%26quot%3B%26quot%3B%20style%3D%26quot%3Bpadding%3A%201.5px%204px%3B%20border-radius%3A%205px%3B%20background-color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.08)%3B%20color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.94)%3B%20font-family%3A%20Menlo%2C%20Monaco%2C%20%26amp%3Bquot%3BCourier%20New%26amp%3Bquot%3B%2C%20monospace%3B%20font-size%3A%200.9em%3B%20line-height%3A%201.4%3B%20word-break%3A%20break-all%3B%26quot%3B%26gt%3Bdashed%20%3D%20control%20%2F%20async%20%2F%20best-effort%26lt%3B%2Fcode%26gt%3B.%20The%20Watcher%20is%20solid-line%20because%20it's%20the%20canonical%2C%20must-succeed%20promotion%20path.%26lt%3B%2Fp%26gt%3B%26lt%3Bh2%20class%3D%26quot%3Bmt-6%20mb-2%20font-semibold%20text-2xl%26quot%3B%20data-streamdown%3D%26quot%3Bheading-2%26quot%3B%20style%3D%26quot%3B--tw-space-y-reverse%3A%200%3B%20margin-block%3A%200px%2016px%3B%20margin-bottom%3A%2010px%3B%20--tw-font-weight%3A%20600%3B%20font-weight%3A%20600%3B%20color%3A%20rgb(204%2C%20204%2C%20204)%3B%20line-height%3A%201.25%3B%20font-size%3A%201.3em%3B%20margin-top%3A%2020px%3B%20font-family%3A%20-apple-system%2C%20%26amp%3Bquot%3Bsystem-ui%26amp%3Bquot%3B%2C%20sans-serif%3B%20font-style%3A%20normal%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20white-space%3A%20normal%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3B4.%20The%20four%20failure%20modes%20walked%20through%26lt%3B%2Fh2%26gt%3B%26lt%3Bp%20style%3D%26quot%3B--tw-space-y-reverse%3A%200%3B%20margin-block%3A%200px%2016px%3B%20margin%3A%206px%200px%3B%20word-break%3A%20break-word%3B%20color%3A%20rgb(204%2C%20204%2C%20204)%3B%20font-family%3A%20-apple-system%2C%20%26amp%3Bquot%3Bsystem-ui%26amp%3Bquot%3B%2C%20sans-serif%3B%20font-size%3A%2013px%3B%20font-style%3A%20normal%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20font-weight%3A%20400%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20white-space%3A%20normal%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3BLet%20me%20trace%20each%20crash%20point%20so%20you%20have%20the%20answer%20ready%3A%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3B--tw-space-y-reverse%3A%200%3B%20margin-block%3A%200px%2016px%3B%20margin%3A%206px%200px%3B%20word-break%3A%20break-word%3B%20color%3A%20rgb(204%2C%20204%2C%20204)%3B%20font-family%3A%20-apple-system%2C%20%26amp%3Bquot%3Bsystem-ui%26amp%3Bquot%3B%2C%20sans-serif%3B%20font-size%3A%2013px%3B%20font-style%3A%20normal%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20font-weight%3A%20400%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20white-space%3A%20normal%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3B%26lt%3Bspan%20class%3D%26quot%3Bfont-semibold%26quot%3B%20data-streamdown%3D%26quot%3Bstrong%26quot%3B%20style%3D%26quot%3B--tw-font-weight%3A%20600%3B%20font-weight%3A%20600%3B%26quot%3B%26gt%3BCase%20A%20%E2%80%94%20Postgres%20commits%2C%20ZADD%20succeeds%20(happy%20path).%26lt%3B%2Fspan%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3BPicker%20pops%20within%20100%20ms.%20Watcher's%20next%20tick%20tries%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bcode%20class%3D%26quot%3B%26quot%3B%20style%3D%26quot%3Bpadding%3A%201.5px%204px%3B%20border-radius%3A%205px%3B%20background-color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.08)%3B%20color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.94)%3B%20font-family%3A%20Menlo%2C%20Monaco%2C%20%26amp%3Bquot%3BCourier%20New%26amp%3Bquot%3B%2C%20monospace%3B%20font-size%3A%200.9em%3B%20line-height%3A%201.4%3B%20word-break%3A%20break-all%3B%26quot%3B%26gt%3BZADD%20%E2%80%A6%20NX%26lt%3B%2Fcode%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3Bfor%20the%20same%20job%20%E2%80%94%20NX%20flag%20rejects%20the%20duplicate.%20No-op.%20%E2%9C%85%26lt%3B%2Fp%26gt%3B%26lt%3Bp%20style%3D%26quot%3B--tw-space-y-reverse%3A%200%3B%20margin-block%3A%200px%2016px%3B%20margin%3A%206px%200px%3B%20word-break%3A%20break-word%3B%20color%3A%20rgb(204%2C%20204%2C%20204)%3B%20font-family%3A%20-apple-system%2C%20%26amp%3Bquot%3Bsystem-ui%26amp%3Bquot%3B%2C%20sans-serif%3B%20font-size%3A%2013px%3B%20font-style%3A%20normal%3B%20font-variant-ligatures%3A%20normal%3B%20font-variant-caps%3A%20normal%3B%20font-weight%3A%20400%3B%20letter-spacing%3A%20normal%3B%20orphans%3A%202%3B%20text-align%3A%20start%3B%20text-indent%3A%200px%3B%20text-transform%3A%20none%3B%20widows%3A%202%3B%20word-spacing%3A%200px%3B%20-webkit-text-stroke-width%3A%200px%3B%20white-space%3A%20normal%3B%20background-color%3A%20rgb(31%2C%2031%2C%2031)%3B%20text-decoration-thickness%3A%20initial%3B%20text-decoration-style%3A%20initial%3B%20text-decoration-color%3A%20initial%3B%26quot%3B%26gt%3B%26lt%3Bspan%20class%3D%26quot%3Bfont-semibold%26quot%3B%20data-streamdown%3D%26quot%3Bstrong%26quot%3B%20style%3D%26quot%3B--tw-font-weight%3A%20600%3B%20font-weight%3A%20600%3B%26quot%3B%26gt%3BCase%20B%20%E2%80%94%20Postgres%20commits%2C%20ZADD%20fails%20(network%20blip%2C%20Redis%20unavailable).%26lt%3B%2Fspan%26gt%3B%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3BJob%20exists%20durably%20in%20Postgres%20with%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bcode%20class%3D%26quot%3B%26quot%3B%20style%3D%26quot%3Bpadding%3A%201.5px%204px%3B%20border-radius%3A%205px%3B%20background-color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.08)%3B%20color%3A%20color(srgb%200.8%200.8%200.8%20%2F%200.94)%3B%20font-family%3A%20Menlo%2C%20Monaco%2C%20%26amp%3Bquot%3BCourier%20New%26amp%3Bquot%3B%2C%20monospace%3B%20font-size%3A%200.9em%3B%20line-height%3A%201.4%3B%20word-break%3A%20break-all%3B%26quot%3B%26gt%3Bstatus%3D'SCHEDULED'%26lt%3B%2Fcode%26gt%3B.%20Job%20Svc%20returns%20200%20to%20the%20user.%20Within%20%E2%89%A4%2060%20s%2C%20the%20Watcher's%20next%20tick%20scans%20Postgres%2C%20finds%20the%20job%2C%20ZADDs%20it.%20Job%20fires%20~30%E2%80%9360%20s%20late%20instead%20of%20within%202%20s.%26lt%3Bspan%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bspan%20class%3D%26quot%3Bfont-semibold%26quot%3B%20data-streamdown%3D%26quot%3Bstrong%26quot%3B%20style%3D%26quot%3B--tw-font-weight%3A%20600%3B%20font-weight%3A%20600%3B%26quot%3B%26gt%3BSLO%20miss%20f