;&quot;&gt;–&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 122.827px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;✓&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 122.827px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;✓&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 122.827px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;–&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 122.827px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;–&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 122.827px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;–&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 122.827px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;✓&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 122.827px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;✓&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 122.827px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;✓&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 122.827px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;–&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 122.827px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;–&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-scroll-area__scrollbar&quot; data-scrollable=&quot;true&quot; role=&quot;presentation&quot; aria-hidden=&quot;true&quot; style=&quot;position: absolute; z-index: 10; inset: auto 0px 0px; width: auto; pointer-events: auto; height: 6px;&quot;&gt;&lt;div class=&quot;ui-scroll-area__thumb&quot; style=&quot;position: absolute; inset: 0px auto 0px 0px; min-height: auto; width: 573px; border-radius: 9999px; background: none 0% 0% / auto repeat scroll padding-box border-box color(srgb 0.8 0.8 0.8 / 0.08); pointer-events: auto; transform: translateX(0px); transition: background-color 0.15s, opacity 0.15s; height: 6px; min-width: 20px; opacity: 0;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;margin: 6px 0px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;That covers every flow the v2 design supports. The four you specifically asked about (good / error / retry / cancel / immediate) are #1, #5, #6, #4, #2 — and the other six (cron, stuck-job sweeper, watcher fallback, etcd failover, outbox publish, hot-shard backpressure) are the ones that come up as follow-up questions in interviews.&lt;/p&gt;" id="80"><mxCell parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1"><mxGeometry height="3840" width="560" x="6030" y="6430" as="geometry"/></mxCell></UserObject>

        <!-- ★ DAG SUPPORT LAYER — added on top of v2 ★ -->
        <mxCell id="dag_banner" parent="1" vertex="1" value="★  DAG SUPPORT LAYER (NEW)  —  additive overlay on the v2 substrate  ·  Airflow / Temporal-style workflows  ·  cycle detection at submit  ·  trigger rules at runtime  ·  no change to Picker / Watcher / Outbox / Sweeper / etcd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#0097A7;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;"><mxGeometry x="5910" y="3990" width="5890" height="34" as="geometry"/></mxCell>
        <mxCell id="dag_wfsvc_b" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0097A7;arcSize=10;strokeWidth=2;"><mxGeometry x="6024" y="4072" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="dag_wfsvc_m" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0097A7;arcSize=10;strokeWidth=2;"><mxGeometry x="6018" y="4066" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="dag_wfsvc" parent="1" vertex="1" value="★ Workflow Service (cluster)&#10;&#10;submit / cancel / runNow workflows&#10;DAG validator: Kahn toposort,&#10;cycle + depth ≤ 50 + |tasks| ≤ 1000&#10;writes wf + tasks + edges + ROOT jobs&#10;in 1 Postgres txn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0097A7;arcSize=10;fontSize=11;fontStyle=1;strokeWidth=2;"><mxGeometry x="6010" y="4060" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="dag_orch_b" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0097A7;arcSize=10;strokeWidth=2;"><mxGeometry x="6294" y="4072" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="dag_orch_m" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0097A7;arcSize=10;strokeWidth=2;"><mxGeometry x="6288" y="4066" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="dag_orch" parent="1" vertex="1" value="★ DAG Orchestrator (cluster)&#10;&#10;Kafka consumer (group, key=wf_id)&#10;evaluates trigger rules · INSERTs&#10;ready downstream tasks into jobs&#10;idempotent · stateless · PG = SoT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0097A7;arcSize=10;fontSize=11;fontStyle=1;strokeWidth=2;"><mxGeometry x="6280" y="4060" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="dag_kafka_taskev" parent="1" vertex="1" value="★ Kafka topic&#10;workflow.task.events&#10;&#10;{type, wf_id, task_id, status,&#10; attempt, ts}&#10;key = wf_id · acks=all · RF=3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#0097A7;fontSize=11;fontStyle=1;strokeWidth=2;"><mxGeometry x="6580" y="4060" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="dag_pg_tables" parent="1" vertex="1" value="★ Postgres tables (NEW for DAG)&#10;━━━━━━━━━━━━━━━━━&#10;workflows       (id, name, version, dag_hash,&#10;                 schedule, status, tenant_id)&#10;tasks           (id, wf_id, name, payload,&#10;                 retry_policy, trigger_rule,&#10;                 status, attempts)&#10;task_deps       (wf_id, upstream_id,&#10;                 downstream_id)   PRIMARY KEY&#10;workflow_runs   (wf_id, run_id, status, started_at)&#10;task_runs       (wf_id, run_id, task_id, status,&#10;                 attempts, started_at, ended_at)&#10;&#10;sharded by tenant_id, partitioned by wf_id&#10;(lives in the SAME PG cluster as v2 jobs/outbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#0097A7;fontSize=10;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;strokeWidth=2;fontFamily=Courier New;"><mxGeometry x="6830" y="4060" width="440" height="270" as="geometry"/></mxCell>
        <mxCell id="dag_trigger_rules" parent="1" vertex="1" value="★ Trigger Rules (per downstream task)&#10;━━━━━━━━━━━━━━━━━━━━━━&#10;all_success    every upstream succeeded   (default)&#10;all_done       every upstream reached terminal&#10;one_success    at least one upstream succeeded&#10;none_failed    no upstream FAILED (skipped OK)&#10;all_failed     every upstream FAILED (cleanup)&#10;&#10;If rule un-satisfiable (e.g. all_success but&#10;one upstream FAILED) → mark task SKIPPED,&#10;cascade SKIPPED to all transitive descendants." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#0097A7;fontSize=10;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;strokeWidth=2;fontFamily=Courier New;"><mxGeometry x="7300" y="4060" width="500" height="170" as="geometry"/></mxCell>
        <mxCell id="dag_cycle_note" parent="1" vertex="1" value="★ Cycle detection at submit (Workflow Svc)&#10;━━━━━━━━━━━━━━━━━━━━━━&#10;Kahn's topological sort on (V, E):&#10;   in_degree[v] for each task&#10;   queue zero in-deg → pop → decrement&#10;   if pop count &lt; |V|  →  cycle  →  400&#10;&#10;Limits enforced:&#10;   • depth ≤ 50  · |tasks| ≤ 1000&#10;   • dag_hash for dedupe / version pinning&#10;&#10;O(V + E) — fast even for 1000 tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#0097A7;fontSize=10;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;strokeWidth=2;fontFamily=Courier New;"><mxGeometry x="7300" y="4240" width="500" height="180" as="geometry"/></mxCell>
        <mxCell id="dag_example" parent="1" vertex="1" value="★ DAG example (Airflow-style)&#10;━━━━━━━━━━━━━━━━━━━━━━&#10;        ┌────────────┐&#10;        │  extract   │  ◄ ROOT (in_deg=0)&#10;        └─────┬──────┘&#10;              │ all_success&#10;              ▼&#10;        ┌────────────┐&#10;        │ transform  │&#10;        └──┬──────┬──┘&#10;           │      │  all_success&#10;           ▼      ▼&#10;       load_a   load_b   ◄ parallel&#10;           │      │&#10;           │      │  all_done&#10;           ▼      ▼&#10;        ┌────────────┐&#10;        │  notify    │   ◄ LEAF&#10;        └────────────┘&#10;&#10;Each box = task row · each edge = task_dep row.&#10;workflow.fire_at = root task fire_at." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#0097A7;fontSize=10;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;strokeWidth=2;fontFamily=Courier New;"><mxGeometry x="7830" y="4060" width="440" height="360" as="geometry"/></mxCell>
        <mxCell id="dag_wflow" parent="1" vertex="1" value="★ Flow W — Workflow / DAG end-to-end&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;&#10;W1   Submit DAG               Client → API GW → Workflow Service&#10;W2   Validate                 Toposort + cycle / depth ≤ 50 / |tasks| ≤ 1000   →   400 on cycle&#10;W3   Persist                  ONE Postgres txn:&#10;                                   • INSERT workflows row    (status = PENDING)&#10;                                   • INSERT N rows into tasks (status = PENDING)&#10;                                   • INSERT M rows into task_dependencies&#10;                                   • For each ROOT task (in_degree = 0):&#10;                                       INSERT into jobs (fire_at = workflow.fire_at, status = SCHEDULED)&#10;W4   Root tasks fire          Watcher → ZADD … NX → Picker (Lua atomic pop) → Kafka.dispatch → Consumer → Executor&#10;                                  (identical to v2's single-job hot path — Picker, Watcher, ZSET unchanged)&#10;W5   Task completes           Executor writes terminal status + outbox event 'task.completed'&#10;                                  in SAME Postgres txn   (idempotency key = (wf_id, task_id, attempt))&#10;W6   Outbox publishes         Outbox Publisher tails outbox → produces to workflow.task.events  (key = wf_id)&#10;W7   Orchestrator evaluates   DAG Orchestrator (consumer group, partition by wf_id):&#10;                                   for each downstream of completed task:&#10;                                       check trigger rule against current upstream statuses&#10;                                       if satisfied:&#10;                                           INSERT into jobs … ON CONFLICT (wf_id, task_id) DO NOTHING&#10;                                           best-effort ZADD if fire_at ≤ 5 min&#10;                                       elif rule un-satisfiable (e.g. all_success but 1 FAILED):&#10;                                           UPDATE task SET status = SKIPPED   →   cascade to descendants&#10;W8   Repeat W4 → W7           until every task is in a terminal state (SUCCEEDED / FAILED / SKIPPED / CANCELED)&#10;W9   Workflow terminal        Orchestrator UPDATEs workflow row (SUCCEEDED if all SUCCEEDED, else FAILED)&#10;&#10;Idempotency:&#10;  • outbox event keyed by (wf_id, task_id, attempt) — duplicate publish OK&#10;  • orchestrator INSERT uses ON CONFLICT (wf_id, task_id) DO NOTHING&#10;  • Kafka offset committed only after PG commit (read-committed, atomic)&#10;&#10;Cancel a workflow:&#10;  • Workflow Svc: CAS workflow.status = CANCEL_REQUESTED + bulk UPDATE all tasks&#10;       (status IN (PENDING, SCHEDULED, QUEUED) → CANCELED)&#10;  • Set Redis cancel:{task_id} for each RUNNING task (cooperative cancel)&#10;  • Sweeper finalizes any task whose lease expires before cooperative cancel succeeds&#10;&#10;Substrate from v2 unchanged: Picker (100ms tick) · Watcher · Outbox Publisher · Sweeper · etcd shard leases · Redis ZSET hot tier · Kafka.dispatch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#0097A7;fontSize=10;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;strokeWidth=2;fontFamily=Courier New;"><mxGeometry x="8300" y="4060" width="3500" height="470" as="geometry"/></mxCell>
        <mxCell id="dag_arr_apigw" parent="1" edge="1" source="11" target="dag_wfsvc" value="★ W1: POST /v1/workflows&#10;(after API GW — new path)" style="endArrow=classic;html=1;rounded=0;strokeColor=#0097A7;strokeWidth=2.5;fontSize=10;fontStyle=1;fontColor=#0097A7;edgeStyle=orthogonalEdgeStyle;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dag_arr_wfsvc_pg" parent="1" edge="1" source="dag_wfsvc" target="14" value="★ W3: 1 PG txn&#10;workflow + tasks + edges + ROOT jobs" style="endArrow=classic;html=1;rounded=0;strokeColor=#0097A7;strokeWidth=2.5;fontSize=10;fontStyle=1;fontColor=#0097A7;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dag_arr_outbox_taskev" parent="1" edge="1" source="57" target="dag_kafka_taskev" value="★ W6: produce 'task.completed'&#10;key = wf_id" style="endArrow=classic;html=1;rounded=0;strokeColor=#0097A7;strokeWidth=2.5;fontSize=10;fontStyle=1;fontColor=#0097A7;edgeStyle=orthogonalEdgeStyle;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dag_arr_taskev_orch" parent="1" edge="1" source="dag_kafka_taskev" target="dag_orch" value="★ W7: consume&#10;(group, partition=wf_id)" style="endArrow=classic;html=1;rounded=0;strokeColor=#0097A7;strokeWidth=2.5;fontSize=10;fontStyle=1;fontColor=#0097A7;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dag_arr_orch_pg" parent="1" edge="1" source="dag_orch" target="14" value="★ W7: INSERT next ready tasks into jobs&#10;ON CONFLICT (wf_id, task_id) DO NOTHING" style="endArrow=classic;html=1;rounded=0;strokeColor=#0097A7;strokeWidth=2.5;fontSize=10;fontStyle=1;fontColor=#0097A7;edgeStyle=orthogonalEdgeStyle;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dag_arr_orch_redis" parent="1" edge="1" source="dag_orch" target="36" value="★ W7: best-effort ZADD…NX  (only if ≤ 5 min)" style="endArrow=classic;html=1;rounded=0;strokeColor=#0097A7;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#0097A7;dashed=1;dashPattern=4 4;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dag_arr_pg_tables_anchor" parent="1" edge="1" source="dag_pg_tables" target="14" value="★ tables live in the same PG cluster (v2)" style="endArrow=none;html=1;rounded=0;strokeColor=#0097A7;strokeWidth=1.5;fontSize=10;fontColor=#0097A7;dashed=1;dashPattern=2 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
