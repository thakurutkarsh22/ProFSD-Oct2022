        <mxCell id="view_agg" value="View Aggregator&#10;(Flink / Beam)&#10;&#10;tumbling 1-min windows&#10;per (video_id, day)&#10;de-dup via HLL+ key&#10;Bigtable INCR · Kafka commit&#10;watermark = max(processing,&#10;event-time + 5 m late)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1060" width="240" height="140" as="geometry" />
