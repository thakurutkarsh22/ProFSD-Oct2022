yle: italic;&quot;&gt;# 2. Fast-path notification (best-effort)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;try&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;        redis&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;set&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;&quot;cancel:&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;job_id&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&