an style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;CANCELLED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; WHERE id&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;$&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; AND &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;SCHEDULED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;INSERT INTO outbox (topic, &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;key&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, payload) VALUES (&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;job.cancelled&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, $&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, …);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;COMMIT;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Used when other services (notifications, billing, audit) subscribe to&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-path-filename-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;&lt;span class=&quot;md-inline-path-filename&quot;&gt;job.cancelled&lt;/span&gt;&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;events. Outbox publisher pushes to Kafka. Pros: external consumers stay consistent. Cons: extra row.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Option B — no outbox row on cancel&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;(pull model)&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 46px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 46px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 56px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;UPDATE jobs SET &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;CANCELLED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; WHERE id&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;$&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; AND &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;SCHEDULED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;SET redis cancel:{id} &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; EX &lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;3600&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;;  &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;-- fast-path flag, best-effort&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Used when only the Executor needs to know, and it checks&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;cancel:{id}&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;+ Postgres status before executing. No external subscribers. Pros: simpler, fewer Kafka events. Cons: external consumers must poll.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Default for this design&lt;/span&gt;: Option B. The cancel signal is&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;consumed by your own dispatcher pipeline&lt;/em&gt;, which already has Postgres as source of truth via the executor's CAS. No external broadcast needed unless an interviewer specifically asks for cancellation events.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Why job lifecycle events (&lt;code class=&quot;md-inline-path-filename-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;&lt;span class=&quot;md-inline-path-filename&quot;&gt;job.completed&lt;/span&gt;&lt;/code&gt;,&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-path-filename-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;&lt;span class=&quot;md-inline-path-filename&quot;&gt;job.failed&lt;/span&gt;&lt;/code&gt;) might need outbox&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;If your design has external consumers that subscribe to lifecycle events (notification service emails the user when their job completes, billing service charges per execution, analytics computes SLO metrics), then yes — when the Executor writes the final&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;UPDATE jobs SET status='SUCCEEDED'&lt;/code&gt;, it should write an outbox row in the same txn:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 86px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 86px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 96px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;BEGIN;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;UPDATE jobs SET &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;SUCCEEDED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, finished_at&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;NOW&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;()&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; WHERE id&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;$&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;INSERT INTO outbox (topic, &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;key&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, payload) VALUES (&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;job.completed&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, $&lt;/span&gt;&lt;span style=&quot;color: rgb(248, 199, 98);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, …);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;COMMIT;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;If the only consumer of &quot;job state&quot; is your own scheduler (which already reads Postgres directly), no outbox needed.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The mental model&lt;/h2&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The outbox table answers exactly one question:&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;&quot;Which Postgres state changes must be reliably mirrored to Kafka, with at-least-once and exactly-once-effective semantics?&quot;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Walk through every write site and ask:&lt;/p&gt;&lt;ol class=&quot;list-inside list-decimal whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;ordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: decimal; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Does this write need to produce a Kafka message?&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Does that Kafka message have an external consumer that&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;cannot afford to miss it&lt;/em&gt;?&lt;/li&gt;&lt;/ol&gt;&lt;ul class=&quot;list-inside list-disc whitespace-normal [li_&amp;amp;]:pl-6&quot; data-streamdown=&quot;unordered-list&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; list-style-type: disc; white-space: normal; padding-left: 2em; display: flex !important; flex-direction: column !important; gap: 6px !important; margin: 6px 0px !important; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Both yes → outbox row.&lt;/li&gt;&lt;li class=&quot;py-1 [&amp;amp;&amp;gt;p]:inline&quot; data-streamdown=&quot;list-item&quot; style=&quot;padding-block: 4px; word-break: break-word; padding: 0px !important;&quot;&gt;Either no → just write the row, skip the outbox.&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;In this design, that boils down to:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 226px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 226px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 236px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;Outbox is written by:&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;  - runNow path                    (always)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;  - executor on terminal status    (only if external consumers exist)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;  - cancellation                   (only if external consumers exist)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;Outbox is NOT written by:&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;  - normal POST /jobs (scheduled)  ← the 95% case&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;  - cron emitter inserting next run&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;  - watcher promoting to ZSET&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;  - picker popping &amp;amp; producing      ← producer is direct; idempotent on job_id&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;  - sweeper requeues                ← internal-only&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The interview answer&lt;/h2&gt;&lt;blockquote class=&quot;my-4 border-muted-foreground/30 border-l-4 pl-4 text-muted-foreground italic&quot; data-streamdown=&quot;blockquote&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; padding: 8px 0px 8px 16px; font-style: italic; margin: 0.5rem 0px; border-left: 2.91667px solid color(srgb 0.8 0.8 0.8 / 0.12); background: rgb(31, 31, 31); color: rgb(204, 204, 204); word-break: break-word; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;p style=&quot;margin: 0px; word-break: break-word;&quot;&gt;&lt;em&gt;&quot;No — only writes that need a Kafka message published in the same transaction. For the scheduled-job submit path, the Kafka publish doesn't happen until fire_at, so there's no dual-write to fix and no outbox row. We only write outbox rows on the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-variable-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;runNow&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;path (where Kafka is needed immediately) and optionally on terminal status updates if external services subscribe to lifecycle events. The outbox isn't a generic event bus — it's specifically the bridge for transactions that must atomically mutate state and emit a message.&quot;&lt;/em&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;That answer signals you understand outbox is a tool with a specific job, not a default sprinkled on every write. Junior candidates write outbox rows everywhere and tank performance. Senior candidates write them exactly where dual-writes would otherwise leak.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;One small follow-up the interviewer might throw&lt;/h2&gt;&lt;blockquote class=&quot;my-4 border-muted-foreground/30 border-l-4 pl-4 text-muted-foreground italic&quot; data-streamdown=&quot;blockquote&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; padding: 8px 0px 8px 16px; font-style: italic; margin: 0.5rem 0px; border-left: 2.91667px solid color(srgb 0.8 0.8 0.8 / 0.12); background: rgb(31, 31, 31); color: rgb(204, 204, 204); word-break: break-word; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;p style=&quot;margin: 0px; word-break: break-word;&quot;&gt;&lt;em&gt;&quot;What if Postgres commits the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;jobs&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;row but the system crashes before&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-variable-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;runNow&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;ever produces — does the outbox row get lost?&quot;&lt;/em&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;No — that's the whole point. Both rows are in&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;the same Postgres transaction&lt;/span&gt;, so they commit atomically. If Postgres commits, both rows are durable. If Postgres rolls back, neither exists. The Outbox Publisher is a separate process that tails the outbox table (polling or Debezium CDC) and publishes to Kafka with at-least-once semantics, then marks the row published. A crash anywhere on the publisher side just means the row is re-published on restart — and the consumer dedups on&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;md-inline-variable-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;job_id&lt;/code&gt;.&lt;/p&gt;&lt;p style=&quot;margin: 6px 0px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;That's the mic drop. The outbox + transactional guarantee + idempotent consumer is the standard pattern, and you've drawn the boundary correctly&lt;/p&gt;" id="75"><mxCell parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1"><mxGeometry height="3220" width="560" x="12620" y="3050" as="geometry"/></mxCell></UserObject><mxCell id="76" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;" value="Outbox only works for NOW case&amp;nbsp;" vertex="1"><mxGeometry height="30" width="220" x="8690" y="3120" as="geometry"/></mxCell><mxCell id="77" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;" value="Zadd - sorted-set add in redis&lt;div&gt;CAS - compare and swap&amp;nbsp;&lt;/div&gt;" vertex="1"><mxGeometry height="80" width="220" x="7800" y="2860" as="geometry"/></mxCell><mxCell id="78" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span&gt;exaplain how does a running job gets cancelled ? &lt;/span&gt;" vertex="1"><mxGeometry height="40" width="300" x="13410" y="2970" as="geometry"/></mxCell><UserObject label="&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 0px 0px 6px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;This is the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;hardest case in cancellation&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;because of one fundamental fact:&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;you cannot safely force-kill a process running arbitrary user code from outside.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;OS&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;kill -9&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;leaves dirty state (open files, half-written DB rows, lost connections); Java's&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;Thread.stop()&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;is deprecated for the same reason. The only correct primitive is&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;cooperative cancellation&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;— the running job has to&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;agree&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;to stop by periodically checking a flag.&lt;/p&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;So the design uses a&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;two-signal, three-state&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;model.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Three states the job could be in when cancel arrives&lt;/h2&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; --scrollbar-size: 6px; --scrollbar-inset: 0px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr; margin: 1em 0px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; border-radius: 6px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: auto; min-width: 100%; max-width: 100%; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;table style=&quot;color: inherit; font-size: inherit; border-collapse: collapse; width: max-content; min-width: 100%; --markdown-table-prose-cell-inline-size: 27ch;&quot;&gt;&lt;thead class=&quot;bg-muted/80&quot; data-streamdown=&quot;table-header&quot; style=&quot;background: none !important;&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;State&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;Where it lives&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot; data-streamdown=&quot;table-header-cell&quot; style=&quot;padding-inline: 16px; padding-block: 8px; text-align: left; font-size: 14px; line-height: 1.42857; --tw-font-weight: 600; font-weight: 600; white-space: nowrap; padding: 5px 9px; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;How cancel works&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody class=&quot;divide-y divide-border bg-muted/40&quot; data-streamdown=&quot;table-body&quot;&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;SCHEDULED&lt;/code&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Postgres (+ maybe ZSET)&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Easy: CAS the status. Picker's Lua skips cancelled jobs.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;QUEUED&lt;/code&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Kafka topic&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Easy: CAS the status. Executor's claim CAS fails, drops message.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot; data-streamdown=&quot;table-row&quot; style=&quot;border: none !important;&quot;&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;RUNNING&lt;/code&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: 0.833333px solid color(srgb 0.8 0.8 0.8 / 0.08); border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;Executing on a worker pod&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;right now&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 9px; text-align: left; vertical-align: top; border-right: none; border-bottom: none;&quot;&gt;&lt;div class=&quot;md-table-cell-content&quot; style=&quot;display: block; min-inline-size: 6ch; max-inline-size: 221.089px; white-space: normal; overflow-wrap: break-word; word-break: normal;&quot;&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Hard.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;This is what the question is about.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The hard one needs the full protocol below.&lt;/p&gt;&lt;h2 class=&quot;mt-6 mb-2 font-semibold text-2xl&quot; data-streamdown=&quot;heading-2&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 10px; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); line-height: 1.25; font-size: 1.3em; margin-top: 20px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The protocol for cancelling a RUNNING job&lt;/h2&gt;&lt;h3 class=&quot;mt-6 mb-2 font-semibold text-xl&quot; data-streamdown=&quot;heading-3&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 8px; font-size: 1.15em; line-height: 1.25; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); margin-top: 18px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Step 1 — User calls&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;DELETE /jobs/{id}&lt;/code&gt;&lt;/h3&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Job Service handles the request.&lt;/p&gt;&lt;h3 class=&quot;mt-6 mb-2 font-semibold text-xl&quot; data-streamdown=&quot;heading-3&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 8px; font-size: 1.15em; line-height: 1.25; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); margin-top: 18px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Step 2 — Job Service flips the state to a&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;transition&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;status&lt;/h3&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;We cannot jump straight to&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;CANCELLED&lt;/code&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;because the executor is still running and may still be writing to downstream systems. We use an intermediate state:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 146px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 146px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 156px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;BEGIN;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;UPDATE jobs&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;SET    &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;              &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;CANCEL_REQUESTED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;,&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;       cancel_requested_at &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; NOW&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;()&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;WHERE  id &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; $job_id&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;  AND  &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;status&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; IN (&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;SCHEDULED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;QUEUED&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;RUNNING&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;'&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;COMMIT;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;This is the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;authoritative&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;signal. CAS guarantees only valid transitions happen (e.g., if status is already&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;SUCCEEDED&lt;/code&gt;, this UPDATE affects 0 rows → API returns &quot;too late&quot;).&lt;/p&gt;&lt;h3 class=&quot;mt-6 mb-2 font-semibold text-xl&quot; data-streamdown=&quot;heading-3&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 8px; font-size: 1.15em; line-height: 1.25; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); margin-top: 18px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Step 3 — Set the Redis cancel flag (the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;em&gt;fast&lt;/em&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;signal)&lt;/h3&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-top: 8px; margin-bottom: 8px; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;div class=&quot;ui-code-block&quot; style=&quot;position: relative; margin-top: 0px; margin-bottom: 0px; border-radius: 8px; border-color: color(srgb 0.8 0.8 0.8 / 0.08); border-style: solid; border-width: 0.833333px; border-image: none 100% / 1 / 0 stretch; overflow: hidden; background-color: rgb(31, 31, 31); min-height: 26px;&quot;&gt;&lt;div class=&quot;ui-code-block-content&quot; style=&quot;position: relative; min-height: 26px;&quot;&gt;&lt;div class=&quot;ui-scroll-area&quot; data-visibility=&quot;hover&quot; data-direction=&quot;horizontal&quot; style=&quot;--scrollbar-size: 6px; --scrollbar-inset: 1px; --scrollbar-thumb-top-offset: 6px; position: relative; overflow: hidden; display: grid; grid-template: 1fr / 1fr;&quot;&gt;&lt;div class=&quot;ui-scroll-area__viewport&quot; style=&quot;grid-area: 1 / 1; min-height: 0px; max-height: 100%; border-radius: inherit; overflow: auto hidden; scroll-padding: 0px 4px; overscroll-behavior: contain; scrollbar-width: none;&quot;&gt;&lt;div class=&quot;ui-scroll-area__content&quot; style=&quot;box-sizing: border-box; width: max-content; min-width: 100%; max-width: none; min-height: 100%; display: flex; flex-direction: row; height: fit-content;&quot;&gt;&lt;div class=&quot;ui-default-code ui-code-block-default-code&quot; style=&quot;min-width: 100%; width: max-content; background: rgb(31, 31, 31); min-height: 36px; padding: 6px 0px; font-size: 12px; font-weight: normal; line-height: 20px; contain: layout style paint; tab-size: 4; font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; --shiki-foreground: #cccccc; --shiki-background: transparent; --shiki-token-constant: #f8c762; --shiki-token-string: #CE9178; --shiki-token-comment: #6A9955; --shiki-token-keyword: #569CD6; --shiki-token-parameter: #9CDCFE; --shiki-token-function: #DCDCAA; --shiki-token-string-expression: #CE9178; --shiki-token-punctuation: #cccccc; --shiki-token-link: #87c3ff; --shiki-token-tag: #569CD6; --shiki-token-attribute: #9CDCFE; --shiki-token-property: #9CDCFE; --shiki-token-type: #4EC9B0; --shiki-token-variable: #9CDCFE; --shiki-token-class: #4EC9B0; --shiki-token-language-variable: #569CD6; --shiki-token-constant-variable: #4FC1FF; --ui-default-code-tab-size: 4;&quot;&gt;&lt;div class=&quot;ui-default-code__content&quot; style=&quot;min-width: fit-content; contain: layout style;&quot;&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span&gt;SET cancel:{job_id} 1 EX 3600&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Why a Redis flag in addition to Postgres?&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600;&quot;&gt;Latency.&lt;/span&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;Polling Postgres from every running executor every second would crush the DB. The cancel flag is a tiny Redis key the executor can&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; background-color: color(srgb 0.8 0.8 0.8 / 0.08); color: color(srgb 0.8 0.8 0.8 / 0.94); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;EXISTS&lt;/code&gt;-poll cheaply (sub-millisecond, no DB load). Postgres is the source of truth; Redis is the fast notification channel.&lt;/p&gt;&lt;h3 class=&quot;mt-6 mb-2 font-semibold text-xl&quot; data-streamdown=&quot;heading-3&quot; style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin-bottom: 8px; font-size: 1.15em; line-height: 1.25; --tw-font-weight: 600; font-weight: 600; color: rgb(204, 204, 204); margin-top: 18px; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Step 4 — Executor's polling loop sees the flag&lt;/h3&gt;&lt;p style=&quot;--tw-space-y-reverse: 0; margin-block: 0px 16px; margin: 6px 0px; word-break: break-word; color: rgb(204, 204, 204); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(31, 31, 31); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The executor wraps user code with a cancellation-aware harness:&lt;/p&gt;&lt;div class=&quot;composer-message-codeblock&quot; style=&quot;