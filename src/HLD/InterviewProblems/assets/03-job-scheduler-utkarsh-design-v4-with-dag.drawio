;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;userJob&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 170);&quot;&gt;onCancel&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;();&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;             &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;// optional user callback&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&lt;div class=&quot;ui-default-code__line-content&quot; style=&quot;flex: 1 1 0%; white-space: pre; overflow: hidden; text-overflow: ellipsis; padding-left: 6px; color: rgb(204, 204, 204); padding-right: 8px; position: relative;&quot;&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 170);&quot;&gt;markCancelled&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;jobId&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;);&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;           &lt;/span&gt;&lt;span style=&quot;color: rgb(106, 153, 85); font-style: italic;&quot;&gt;// UPDATE jobs SET status='CANCELLED'&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;ui-default-code__line&quot; style=&quot;display: flex; min-height: 20px;&quot;&gt;&